rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isActiveUser() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    // حساب الأدمن الوحيد (لوحة التحكم): يقرأ كل المنشورات والبلاغات ويحذفها.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == '7M8bvw0UUiR8Ouxx28nq4i4spQF3';
    }

    function followsAfter(followerUid, followedUid) {
      return existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(followedUid));
    }

    function isMutualFriendAfter(firstUid, secondUid) {
      return followsAfter(firstUid, secondUid)
        && followsAfter(secondUid, firstUid);
    }

    function isPrivateUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('isPrivate', false) == true;
    }

    function isBlocked(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/userBlocks/$(firstUid)/blocked/$(secondUid))
        || exists(/databases/$(database)/documents/userBlocks/$(secondUid)/blocked/$(firstUid));
    }

    // ملفي الشخصي كما هو مخزّن في الخادم (لا نثق بما يرسله العميل).
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // اسم الكاتب في المنشور/التعليق يجب أن يطابق ملفه الحقيقي (يمنع الانتحال).
    // name يقبل الاسم المعروض أو اسم المستخدم لأن التطبيق يرجع إليه إن كان الاسم فارغاً.
    function authorMatchesProfile() {
      return request.resource.data.username is string
        && request.resource.data.username == myProfile().username
        && request.resource.data.name is string
        && (request.resource.data.name == myProfile().name
            || request.resource.data.name == myProfile().username);
    }

    // هل أتابع هذا المستخدم؟
    function followsUser(targetUid) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(targetUid));
    }

    // هل يحق لي قراءة هذا المنشور؟ منشور عام، أو منشوري، أو صاحبه حساب خاص وأتابعه.
    // authorPrivate يُكتب على المنشور عند إنشائه ويُزامَن عند تبديل خصوصية الحساب.
    // المنشورات القديمة التي لا تملك الحقل تُعامل كعامة إلى أن يُشغَّل سكربت الترحيل.
    function canReadPost(data) {
      return data.get('authorPrivate', false) == false
        || data.uid == request.auth.uid
        || followsUser(data.uid);
    }

    // قراءة المنشور الأب (للتعليقات والإعجابات).
    function parentPostReadable(postId) {
      return canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
    }

    // الإعجابات المخفية وقوائم الإعجاب: لا تُعرض إلا إذا سمح صاحبها وكان ملفه مرئياً لي.
    function canViewLikes(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('hideLikes', false) != true
        && (!isPrivateUser(uid) || followsUser(uid));
    }

    // الإعجاب يغيّر العدّاد فقط إذا تغيّر مستند الإعجاب الحقيقي في العملية نفسها.
    function likeDocPath(postId) {
      return /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
    }

    function validNotificationCreate(ownerUid, notificationId) {
      let data = request.resource.data;
      let actorUid = request.auth.uid;
      return data.actorUid == actorUid
        && actorUid != ownerUid
        && data.actorUsername is string
        && data.actorUsername.size() <= 24
        && get(/databases/$(database)/documents/users/$(actorUid)).data.username
          == data.actorUsername
        && data.read == false
        && data.createdAt == request.time
        && (
          (data.type == 'follow'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'read', 'createdAt'])
            && notificationId == 'follow_' + actorUid
            && existsAfter(/databases/$(database)/documents/users/$(ownerUid)/followers/$(actorUid))
            && followsAfter(actorUid, ownerUid))
          ||
          (data.type == 'followRequest'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'read', 'createdAt'])
            && notificationId == 'followRequest_' + actorUid
            && existsAfter(/databases/$(database)/documents/users/$(ownerUid)/followRequests/$(actorUid)))
          ||
          (data.type == 'followAccepted'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'read', 'createdAt'])
            && notificationId == 'followAccepted_' + actorUid
            && existsAfter(/databases/$(database)/documents/users/$(ownerUid)/following/$(actorUid)))
          ||
          (data.type == 'like'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'postId', 'read', 'createdAt'])
            && data.postId is string
            && notificationId == 'like_' + data.postId + '_' + actorUid
            && get(/databases/$(database)/documents/posts/$(data.postId)).data.uid == ownerUid
            && existsAfter(/databases/$(database)/documents/posts/$(data.postId)/likes/$(actorUid)))
          ||
          (data.type == 'comment'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'postId', 'commentId', 'commentText', 'read', 'createdAt'])
            && data.postId is string
            && data.commentId is string
            && data.commentText is string
            && data.commentText.size() > 0
            && data.commentText.size() <= 500
            && notificationId == 'comment_' + data.commentId
            && get(/databases/$(database)/documents/posts/$(data.postId)).data.uid == ownerUid
            && getAfter(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId)).data.uid == actorUid
            && getAfter(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId)).data.text == data.commentText)
        );
    }

      // يسمح للمستخدم بقراءة حالة حظره فقط حتى يسجّل التطبيق خروجه؛ لا يستطيع العميل تعديلها.
      match /blockedUsers/{uid} {
        allow get: if request.auth != null
          && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        allow write: if false;
      }

    match /posts/{postId} {
      // الحساب الخاص: منشوراته لصاحبه ولمتابعيه فقط (تُفرض هنا في الخادم لا في الواجهة).
      // قواعد القراءة ليست فلتراً: استعلامات القوائم يجب أن تحمل where('authorPrivate', '==', false)
      // أو تقيّد uid بنفسي/بمن أتابعه، وإلا يرفضها Firestore كاملة.
      allow read: if isActiveUser()
        && (isAdmin() || canReadPost(resource.data));
      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.caption.size() <= 500
        && request.resource.data.likes == 0
        && request.resource.data.get('comments', 0) == 0
        && request.resource.data.get('views', 0) == 0
        && request.resource.data.get('shares', 0) == 0
        && authorMatchesProfile()
        && request.resource.data.authorPrivate is bool
        && request.resource.data.authorPrivate == (myProfile().get('isPrivate', false) == true)
        && (!('videoId' in request.resource.data)
            || (request.resource.data.videoId is string
                && request.resource.data.videoId.matches('^[A-Za-z0-9_-]{11}$')));
      // المالك يعدّل نص المنشور فقط. أي مستخدم مسجّل يستطيع:
      //  - الإعجاب/إلغاؤه: العدّاد يتغيّر بمقدار 1 فقط وبالتزامن مع إنشاء/حذف مستند إعجابه هو.
      //  - زيادة/إنقاص عدّاد التعليقات بمقدار 1، وزيادة المشاركات بمقدار 1.
      allow update: if isActiveUser() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])
          && request.resource.data.caption is string
          && request.resource.data.caption.size() <= 500) ||
        // مزامنة authorPrivate عند تبديل خصوصية حسابي (يجب أن تطابق ملفي الحالي).
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorPrivate'])
          && request.resource.data.authorPrivate is bool
          && request.resource.data.authorPrivate == (myProfile().get('isPrivate', false) == true)) ||
        // التفاعل (إعجاب/تعليق/مشاركة) لمن يحق له رؤية المنشور فقط.
        (canReadPost(resource.data) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && (
              (request.resource.data.likes == resource.data.likes + 1
                && !exists(likeDocPath(postId))
                && existsAfter(likeDocPath(postId)))
              ||
              (request.resource.data.likes == resource.data.likes - 1
                && exists(likeDocPath(postId))
                && !existsAfter(likeDocPath(postId)))
            )) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
            && request.resource.data.comments is int
            && request.resource.data.comments >= 0
            && (request.resource.data.comments == resource.data.get('comments', 0) + 1
              || request.resource.data.comments < resource.data.get('comments', 0))) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares'])
            && request.resource.data.shares == resource.data.get('shares', 0) + 1)
        )) ||
        // لوحة التحكم: تنقيص عدّاد التعليقات عند حذف تعليق مُبلَّغ عنه.
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && request.resource.data.comments is int
          && request.resource.data.comments >= 0
          && request.resource.data.comments < resource.data.get('comments', 0))
      );
      allow delete: if isActiveUser()
        && (isAdmin() || resource.data.uid == request.auth.uid);

      match /likes/{uid} {
        // مستند إعجابي أنا يُقرأ دائماً (بلا قراءة إضافية)، وإعجابات غيري تتبع قابلية قراءة المنشور.
        allow read: if isActiveUser()
          && (request.auth.uid == uid || parentPostReadable(postId));
        allow write: if isActiveUser() && request.auth.uid == uid;
      }

      // مشاهدات القصص: كل مشاهد يسجّل نفسه فقط (وقت الخادم)، ويقرؤها صاحب القصة وحده.
      match /views/{viewerUid} {
        allow read: if isActiveUser()
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
        allow create, update: if isActiveUser()
          && request.auth.uid == viewerUid
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid != viewerUid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if false;
      }

      // التعليقات: يكتبها أي مستخدم مسجّل، ويحذفها صاحبها أو صاحب المنشور
      match /comments/{commentId} {
        allow read: if isActiveUser()
          && (isAdmin() || parentPostReadable(postId));
        allow create: if isActiveUser()
          && parentPostReadable(postId)
          && request.resource.data.uid == request.auth.uid
          && authorMatchesProfile()
          && request.resource.data.get('likedBy', []) == []
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.get('kind', 'text') in ['text', 'sticker', 'image']
          // الردود: مستوى واحد فقط؛ الأب موجود وليس ردّاً بدوره.
          && (!('parentId' in request.resource.data)
            || (request.resource.data.parentId is string
              && request.resource.data.parentId.size() > 0
              && request.resource.data.parentId.size() <= 40
              && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId))
              && !('parentId' in get(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId)).data)))
          && (!('replyToUsername' in request.resource.data)
            || ('parentId' in request.resource.data
              && request.resource.data.replyToUsername is string
              && request.resource.data.replyToUsername.size() <= 24))
          && (!('image' in request.resource.data)
            || (request.resource.data.kind == 'image'
              && request.resource.data.image is bytes
              && request.resource.data.image.size() <= 716800));
        allow update: if isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy'])
          && request.resource.data.likedBy is list
          && request.resource.data.likedBy.size()
            <= resource.data.get('likedBy', []).size() + 1
          && request.resource.data.likedBy.size()
            >= resource.data.get('likedBy', []).size() - 1
          && (
            (request.resource.data.likedBy.hasAll(
                resource.data.get('likedBy', [])
              )
              && request.resource.data.likedBy.size()
                == resource.data.get('likedBy', []).size() + 1
              && !resource.data.get('likedBy', []).hasAny([request.auth.uid])
              && request.resource.data.likedBy.hasAny([request.auth.uid]))
            ||
            (resource.data.get('likedBy', []).hasAll(
                request.resource.data.likedBy
              )
              && request.resource.data.likedBy.size()
                == resource.data.get('likedBy', []).size() - 1
              && resource.data.get('likedBy', []).hasAny([request.auth.uid])
              && !request.resource.data.likedBy.hasAny([request.auth.uid]))
          );
        allow delete: if isActiveUser() && (
          isAdmin() ||
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid ||
          // صاحب التعليق الأب يحذف الردود عليه عند حذف تعليقه.
          ('parentId' in resource.data
            && get(/databases/$(database)/documents/posts/$(postId)/comments/$(resource.data.parentId)).data.uid == request.auth.uid)
        );
      }
    }

    match /chats/{chatId} {
      function isParticipant() {
        return isActiveUser()
          && request.auth.uid in resource.data.participants;
      }

      // حقل خريطة (readAt / deliveredAt / clearedAt) يخص المستخدم الحالي فقط:
      // لا يتغير فيه إلا مدخله، وقيمته وقت صالح لا يتجاوز الآن ولا يتراجع.
      function touchesOnlyMine(field) {
        let before = resource.data.get(field, {});
        let after = request.resource.data[field];
        return after is map
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && after[request.auth.uid] is timestamp
          && after[request.auth.uid] <= request.time
          && (!(request.auth.uid in before)
            || after[request.auth.uid] > before[request.auth.uid]);
      }

      // لا نسمح بقراءة مستند غير موجود (كان يكشف هل تراسل مستخدمان أم لا):
      // البدء يتم بالإنشاء ثم القراءة من الطرفين فقط.
      // الأدمن يقرأ ملخصات المحادثات للوحة التحكم؛ الرسائل الفرعية تبقى للمشاركين فقط.
      allow get: if isAdmin() || isParticipant();
      allow list: if isAdmin() || isParticipant();
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'participants', 'lastMessage', 'lastSenderUid', 'lastMessageId',
          'createdAt', 'updatedAt', 'accepted'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] < request.resource.data.participants[1]
        // المعرّف يجب أن يطابق المعرّف المحسوب من الطرفين، لمنع حجز معرّف محادثة غيرك.
        && chatId == string(request.resource.data.participants[0].size()) + '_'
          + request.resource.data.participants[0]
          + string(request.resource.data.participants[1].size()) + '_'
          + request.resource.data.participants[1]
        && !isBlocked(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        )
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastSenderUid == ''
        && request.resource.data.lastMessageId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        // كل محادثة جديدة تبدأ «غير مقبولة»؛ تُفتح عند ردّ الطرف الآخر.
        && request.resource.data.accepted == false;
      allow update: if isActiveUser()
        && resource.data.participants is list
        && resource.data.participants.hasAny([request.auth.uid])
        && (
          (!isBlocked(
              resource.data.participants[0],
              resource.data.participants[1]
            )
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'lastMessage', 'lastSenderUid', 'lastMessageId', 'updatedAt',
                'accepted', 'startedBy'
              ])
            // «startedBy»: قائمة بمن أرسل رسالة افتتاحية في هذه المحادثة. لا
            // تُمسح بحذف الرسالة، فلا يمكن تكرار «أرسل ثم احذف» لتجاوز حدّ
            // الرسالة الواحدة لغير الأصدقاء. تزيد بإضافة مدخل واحد: أنا فقط.
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['startedBy'])
              || (request.resource.data.startedBy is list
                && request.resource.data.startedBy
                  .hasAll(resource.data.get('startedBy', []))
                && request.resource.data.startedBy.hasAny([request.auth.uid])
                && request.resource.data.startedBy.size()
                  <= resource.data.get('startedBy', []).size() + 1
                && request.resource.data.startedBy.size() <= 2))
            // «accepted» لا يتغير إلا من false إلى true، ومن الطرف الذي ردّ على
            // رسالة الطرف الآخر (آخر مرسل قبل هذه الكتابة ليس أنا).
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['accepted'])
              || (resource.data.get('accepted', true) == false
                && request.resource.data.accepted == true
                && resource.data.lastSenderUid != ''
                && resource.data.lastSenderUid != request.auth.uid))
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 2000
            && request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessageId is string
            && request.resource.data.lastMessageId.size() > 0
            && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderUid
              == request.auth.uid
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text
              == request.resource.data.lastMessage
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.createdAt
              == request.time)
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'lastMessage', 'lastSenderUid', 'lastMessageId', 'updatedAt'
              ])
            && request.resource.data.updatedAt == request.time
            && resource.data.lastMessageId is string
            && resource.data.lastMessageId.size() > 0
            && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId))
            && get(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId)).data.senderUid
              == request.auth.uid
            && !existsAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId))
            && (
              (request.resource.data.lastMessage == ''
                && request.resource.data.lastSenderUid == ''
                && request.resource.data.lastMessageId == '')
              ||
              (request.resource.data.lastMessage is string
                && request.resource.data.lastMessage.size() > 0
                && request.resource.data.lastMessage.size() <= 2000
                && request.resource.data.lastSenderUid is string
                && request.resource.data.lastMessageId is string
                && request.resource.data.lastMessageId.size() > 0
                && request.resource.data.lastMessageId
                  != resource.data.lastMessageId
                && existsAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId))
                && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text
                  == request.resource.data.lastMessage
                && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderUid
                  == request.resource.data.lastSenderUid))
          )
          ||
          // إيصالات المحادثة ومسحها لديّ: كل مستخدم يكتب مدخله فقط.
          // readAt = وقت آخر رسالة قرأتها، deliveredAt = آخر رسالة وصلتني،
          // clearedAt = «حذف المحادثة لديّ» (يخفي ما قبله عني فقط).
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['readAt', 'deliveredAt', 'clearedAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['readAt'])
              || touchesOnlyMine('readAt'))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['deliveredAt'])
              || touchesOnlyMine('deliveredAt'))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['clearedAt'])
              || (touchesOnlyMine('clearedAt')
                && request.resource.data.clearedAt[request.auth.uid]
                  == request.time)))
        );
      allow delete: if false;

      match /messages/{messageId} {
        function isChatParticipant() {
          return isActiveUser()
            && request.auth.uid in
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        function chatNow() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function chatNext() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function validReactionUpdate() {
          let before = resource.data.get('reactions', {});
          let after = request.resource.data.get('reactions', {});
          let uid = request.auth.uid;
          return after is map
            && after.keys().hasOnly(chatNow().participants)
            && after.diff(before).affectedKeys().hasOnly([uid])
            && (!(uid in after)
              || (after[uid] is string
                && after[uid].size() > 0
                && after[uid].size() <= 8));
        }
        // متابعة متبادلة بين طرفي المحادثة.
        function areMutualFriends() {
          let p = chatNow().participants;
          let other = p[0] == request.auth.uid ? p[1] : p[0];
          return exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(other))
            && exists(/databases/$(database)/documents/users/$(other)/following/$(request.auth.uid));
        }
        // من يحق له الإرسال الآن:
        // 1) محادثة مفتوحة (قديمة بلا الحقل، أو ردّ فيها الطرف الآخر)،
        // 2) أصدقاء (متابعة متبادلة)،
        // 3) أول رسالة لغريب: نص فقط، ولا رسائل قبلها،
        // 4) ردّ على آخر رسالة من الطرف الآخر (ويجب أن تصبح المحادثة مقبولة).
        function canSendNow() {
          return chatNow().get('accepted', true) == true
            || areMutualFriends()
            || (chatNow().lastMessageId == ''
              && request.resource.data.kind == 'text'
              // من افتتح المحادثة مرة (ولو حذف رسالته) لا يفتتحها ثانية.
              && !(request.auth.uid in chatNow().get('startedBy', [])))
            || (chatNow().lastMessageId != ''
              && chatNow().lastSenderUid != request.auth.uid
              && chatNext().get('accepted', true) == true);
        }

        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.keys().hasOnly([
            'senderUid', 'text', 'kind', 'image', 'imageUrl', 'attachmentUrl',
            'attachmentName', 'contentType', 'deliveredTo', 'readBy',
            'createdAt', 'replyToMessageId', 'replyToText', 'replyToSenderUid'
          ])
          && request.resource.data.keys().hasAll([
            'senderUid', 'text', 'kind', 'deliveredTo', 'readBy', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && (!('replyToMessageId' in request.resource.data)
            || (request.resource.data.replyToMessageId is string
              && request.resource.data.replyToMessageId.size() > 0
              && request.resource.data.replyToMessageId.size() <= 128
              && request.resource.data.replyToText is string
              && request.resource.data.replyToText.size() <= 2000
              && request.resource.data.replyToSenderUid is string
              && request.resource.data.replyToSenderUid in chatNow().participants))
          && (
            (request.resource.data.kind == 'image'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'image', 'imageUrl',
                'deliveredTo', 'readBy', 'createdAt', 'replyToMessageId',
                'replyToText', 'replyToSenderUid'
              ])
              && (
                (('image' in request.resource.data)
                  && !('imageUrl' in request.resource.data)
                  && request.resource.data.image is bytes
                  && request.resource.data.image.size() <= 716800)
                ||
                (('imageUrl' in request.resource.data)
                  && !('image' in request.resource.data)
                  && request.resource.data.imageUrl is string
                  && request.resource.data.imageUrl.size() <= 1000
                  && request.resource.data.imageUrl.matches(
                    '^https://(res[.]cloudinary[.]com|firebasestorage[.]googleapis[.]com)/.+$'))
              ))
            ||
            (request.resource.data.kind == 'text'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'deliveredTo', 'readBy',
                'createdAt', 'replyToMessageId', 'replyToText',
                'replyToSenderUid'
              ])
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.kind == 'sticker'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'deliveredTo', 'readBy',
                'createdAt', 'replyToMessageId', 'replyToText',
                'replyToSenderUid'
              ])
              && request.resource.data.text.size() <= 24)
            ||
            (request.resource.data.kind in ['video', 'audio', 'file']
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'attachmentUrl',
                'attachmentName', 'contentType', 'deliveredTo', 'readBy',
                'createdAt', 'replyToMessageId', 'replyToText',
                'replyToSenderUid'
              ])
              && request.resource.data.text.size() <= 160
              && request.resource.data.attachmentName is string
              && request.resource.data.attachmentName.size() > 0
              && request.resource.data.attachmentName.size() <= 160
              && request.resource.data.attachmentUrl is string
              && request.resource.data.attachmentUrl.size() <= 1200
              && request.resource.data.attachmentUrl.matches(
                '^https://firebasestorage[.]googleapis[.]com/.+$')
              && request.resource.data.contentType is string
              && request.resource.data.contentType.size() <= 120
              && ((request.resource.data.kind == 'video'
                    && request.resource.data.contentType.matches('video/.*'))
                || (request.resource.data.kind == 'audio'
                    && request.resource.data.contentType.matches('audio/.*'))
                || request.resource.data.kind == 'file'))
          )
          && !isBlocked(
            chatNow().participants[0],
            chatNow().participants[1]
          )
          && canSendNow()
          && request.resource.data.deliveredTo == [request.auth.uid]
          && request.resource.data.readBy == [request.auth.uid]
          && request.resource.data.createdAt == request.time
          && chatNext().lastSenderUid == request.auth.uid
          && chatNext().lastMessageId == messageId
          && (chatNext().get('accepted', true) == true
            || request.auth.uid in chatNext().get('startedBy', []))
          && chatNext().lastMessage == request.resource.data.text;
        allow update: if isChatParticipant()
          && (
            (resource.data.senderUid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['deliveredTo', 'readBy'])
              && request.resource.data.deliveredTo is list
              && request.resource.data.deliveredTo
                .hasAll(resource.data.get('deliveredTo', []))
              && request.resource.data.deliveredTo.hasAny([request.auth.uid])
              && request.resource.data.deliveredTo.size()
                <= resource.data.get('deliveredTo', []).size() + 1
              && request.resource.data.readBy is list
              && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
              && request.resource.data.readBy.hasAny([request.auth.uid])
              && request.resource.data.readBy.size()
                <= resource.data.get('readBy', []).size() + 1)
            ||
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions'])
              && validReactionUpdate())
          );
        allow delete: if isChatParticipant()
          && resource.data.senderUid == request.auth.uid;
      }

      // رسائل «حذف لديّ فقط»: مستند لكل مستخدم يخص نفسه فقط.
      match /hiddenMessages/{uid} {
        function isParticipantHere() {
          return isActiveUser()
            && request.auth.uid in
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if isParticipantHere() && request.auth.uid == uid;
        allow create, update: if isParticipantHere()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ids', 'updatedAt'])
          && request.resource.data.ids is list
          && request.resource.data.ids.size() <= 500
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /userBlocks/{uid}/blocked/{otherUid} {
      allow read: if isActiveUser()
        && (request.auth.uid == uid || request.auth.uid == otherUid);
      allow create: if isActiveUser()
        && request.auth.uid == uid
        && uid != otherUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isActiveUser() && request.auth.uid == uid;
    }

    // البلاغات: الإنشاء فقط من المستخدم المسجّل، والقراءة والحذف للأدمن فقط (لوحة التحكم).
    match /reports/{reportId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'type', 'targetUid', 'reporterUid', 'reason', 'details', 'createdAt',
          'postId', 'commentId'
        ])
        && ((request.resource.data.type == 'user'
              && !('postId' in request.resource.data)
              && !('commentId' in request.resource.data))
            || (request.resource.data.type == 'post'
              && request.resource.data.postId is string
              && request.resource.data.postId.size() > 0
              && request.resource.data.postId.size() <= 40
              && !('commentId' in request.resource.data))
            || (request.resource.data.type == 'comment'
              && request.resource.data.postId is string
              && request.resource.data.postId.size() > 0
              && request.resource.data.postId.size() <= 40
              && request.resource.data.commentId is string
              && request.resource.data.commentId.size() > 0
              && request.resource.data.commentId.size() <= 40))
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason in [
          'spam', 'abuse', 'inappropriate', 'impersonation', 'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /presence/{uid} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['online', 'updatedAt'])
        && request.resource.data.online is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if isActiveUser() && request.auth.uid == uid;
    }

    // قطع الملفات (وضع التجربة): كل قطعة تحمل uid صاحبها، لا تُعدَّل، ويحذفها صاحبها فقط
    match /media/{chunkId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data.size() < 950000;
      allow update: if false;
      allow delete: if isActiveUser() && resource.data.uid == request.auth.uid;
    }

    // حجز أسماء المستخدمين (فريدة). القراءة المفردة مفتوحة للتحقق من التوفر قبل التسجيل.
    match /usernames/{name} {
      allow get: if true;
      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9._]{3,24}$');
      allow update: if false;
      allow delete: if isActiveUser() && resource.data.uid == request.auth.uid;
    }

    // الملف الشخصي: الاسم + اسم المستخدم + النبذة
    match /users/{uid} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9._]{3,24}$')
        // اسم المستخدم: إما لم يتغيّر، أو محجوز باسمي في usernames (يمنع أخذ اسم غيري).
        && (
          (resource != null
            && resource.data.get('username', '') == request.resource.data.username)
          || (existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username))
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid
              == request.auth.uid)
        )
        && request.resource.data.name.size() <= 50
        && request.resource.data.bio.size() <= 150
        && request.resource.data.get('website', '') is string
        && request.resource.data.get('website', '').size() <= 100
        && (request.resource.data.get('website', '') == ''
            || request.resource.data.get('website', '').matches('^https?://[^ ]+$'))
        && request.resource.data.get('pinnedPostIds', []).size() <= 3
        && (request.resource.data.get('photoB64', null) == null
            || request.resource.data.photoB64.size() < 200000);
    }

    match /users/{uid}/{sub}/{doc} {
      // طلبات المتابعة: يقرؤها صاحب الحساب أو مرسل الطلب فقط. المحفوظات لصاحبها، والإعجابات حسب إعدادات صاحبها،
      // وباقي المجموعات (المتابَعون/المتابِعون) مفتوحة للقراءة لأن العدّادات تعتمد عليها.
      allow read: if isActiveUser()
        && (sub != 'notifications' || request.auth.uid == uid)
        && (sub != 'followRequests' || request.auth.uid == uid || request.auth.uid == doc)
        && (sub != 'profileVisits' || request.auth.uid == uid)
        && (sub != 'hiddenPosts' || request.auth.uid == uid)
        && (sub != 'pushTokens' || request.auth.uid == uid)
        // المحفوظات خاصة بصاحبها وحده.
        && (sub != 'saved' || request.auth.uid == uid)
        // قائمة الإعجابات: تحترم «إخفاء الإعجابات» وخصوصية الحساب.
        && (sub != 'liked' || request.auth.uid == uid || canViewLikes(uid));

      allow create: if isActiveUser() && (
        (request.auth.uid == uid && sub == 'pushTokens'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 30
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['web', 'android', 'ios']
          && request.resource.data.updatedAt == request.time) ||
        // المالك: saved / liked ... لكن ليس followers ولا followRequests ولا الإشعارات.
        (request.auth.uid == uid
          && !(sub in ['notifications', 'followers', 'followRequests', 'following', 'pushTokens'])) ||
        // متابعة مباشرة: فقط إذا كان الحساب الهدف عاماً.
        (sub == 'following' && request.auth.uid == uid
          && doc != uid && !isPrivateUser(doc)
          && !isBlocked(uid, doc)) ||
        (sub == 'followers' && doc == request.auth.uid
          && doc != uid && !isPrivateUser(uid)
          && !isBlocked(uid, doc)) ||
        // طلب متابعة: يرسله المتابِع إلى حساب خاص فقط.
        (sub == 'followRequests' && doc == request.auth.uid
          && doc != uid && isPrivateUser(uid)
          && !isBlocked(uid, doc)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && !exists(/databases/$(database)/documents/users/$(uid)/followers/$(doc))) ||
        // الموافقة: صاحب الحساب الخاص يضيف المتابِع بعد وجود طلبه فقط.
        (sub == 'followers' && request.auth.uid == uid
          && exists(/databases/$(database)/documents/users/$(uid)/followRequests/$(doc))) ||
        (sub == 'following' && doc == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(doc)/followRequests/$(uid))) ||
        // زيارة الملف الشخصي: الزائر يسجّل زيارته بنفسه فقط (وقت الخادم).
        (sub == 'profileVisits' && doc == request.auth.uid
          && doc != uid && !isBlocked(uid, doc)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time) ||
        (sub == 'notifications' && validNotificationCreate(uid, doc))
      );
      allow update: if isActiveUser() && (
        (request.auth.uid == uid && sub == 'pushTokens'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 30
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['web', 'android', 'ios']
          && request.resource.data.updatedAt == request.time) ||
        (request.auth.uid == uid
          && !(sub in ['notifications', 'followers', 'followRequests', 'following', 'pushTokens'])) ||
        (sub == 'following' && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])) ||
        (sub == 'followers' && doc == request.auth.uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time) ||
        // زيارة الملف الشخصي: الزائر يسجّل زيارته بنفسه فقط (وقت الخادم).
        (sub == 'profileVisits' && doc == request.auth.uid
          && doc != uid && !isBlocked(uid, doc)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time) ||
        (sub == 'notifications' && validNotificationCreate(uid, doc)) ||
        (sub == 'notifications' && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool)
      );
      allow delete: if isActiveUser()
        && ((request.auth.uid == uid && sub != 'notifications' && sub != 'followers')
          || (sub == 'followers' && doc == request.auth.uid)
          || (sub == 'followRequests' && doc == request.auth.uid)
          || (sub == 'notifications' && request.auth.uid == uid));
    }
  }
}
