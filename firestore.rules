rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isActiveUser() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/blockedUsers/$(request.auth.uid));
    }

    // زائر يتصفح بدون تسجيل دخول (قراءة فقط، للمحتوى العام فقط).
    function isGuest() {
      return request.auth == null;
    }

    // حساب الأدمن الوحيد (لوحة التحكم): يقرأ كل المنشورات والبلاغات ويحذفها.
    function isAdmin() {
      return request.auth != null
        && request.auth.uid == '7M8bvw0UUiR8Ouxx28nq4i4spQF3';
    }

    function followsAfter(followerUid, followedUid) {
      return existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(followedUid));
    }

    function isMutualFriendAfter(firstUid, secondUid) {
      return followsAfter(firstUid, secondUid)
        && followsAfter(secondUid, firstUid);
    }

    function isPrivateUser(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('isPrivate', false) == true;
    }

    function isBlocked(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/userBlocks/$(firstUid)/blocked/$(secondUid))
        || exists(/databases/$(database)/documents/userBlocks/$(secondUid)/blocked/$(firstUid));
    }

    // ملفي الشخصي كما هو مخزّن في الخادم (لا نثق بما يرسله العميل).
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // اسم الكاتب في المنشور/التعليق يجب أن يطابق ملفه الحقيقي (يمنع الانتحال).
    // name يقبل الاسم المعروض أو اسم المستخدم لأن التطبيق يرجع إليه إن كان الاسم فارغاً.
    function authorMatchesProfile() {
      return request.resource.data.username is string
        && request.resource.data.username == myProfile().username
        && request.resource.data.name is string
        && (request.resource.data.name == myProfile().name
            || request.resource.data.name == myProfile().username);
    }

    // موضع عنصر تفاعلي (استطلاع/أسئلة/شريط) فوق القصة: كلها اختيارية.
    function validStoryPos(m) {
      return (!('x' in m) || (m.x is number && m.x >= 0 && m.x <= 1))
          && (!('y' in m) || (m.y is number && m.y >= 0 && m.y <= 1))
          && (!('s' in m) || (m.s is number && m.s >= 0.3 && m.s <= 3))
          && (!('ar' in m) || (m.ar is number && m.ar >= 0.1 && m.ar <= 10));
    }
    // تفاعل المشاهد بإيموجي على القصة (اختياري، نص قصير).
    function validViewReaction(d) {
      return !('e' in d) || (d.e is string && d.e.size() > 0 && d.e.size() <= 16);
    }
    // معلومات القصة (رابط/موقع/عدّ تنازلي/وقت): كلها اختيارية وبحدود صارمة.
    function hasStoryInfo(d) {
      return 'link' in d || 'location' in d || 'countdown' in d || 'time' in d;
    }
    function validStoryInfo(d) {
      return (!('link' in d)
              || (d.link is map
                  && d.link.keys().hasOnly(['u', 'l'])
                  && d.link.u is string
                  && d.link.u.size() <= 300
                  && d.link.u.matches('^https?://[^ ]+$')
                  && d.link.l is string
                  && d.link.l.size() <= 40))
          && (!('location' in d)
              || (d.location is map
                  && d.location.keys().hasOnly(['n'])
                  && d.location.n is string
                  && d.location.n.size() > 0
                  && d.location.n.size() <= 60))
          && (!('countdown' in d)
              || (d.countdown is map
                  && d.countdown.keys().hasOnly(['t', 'at'])
                  && d.countdown.t is string
                  && d.countdown.t.size() > 0
                  && d.countdown.t.size() <= 60
                  && d.countdown.at is int))
          && (!('time' in d)
              || (d.time is map
                  && d.time.keys().hasOnly(['m'])
                  && d.time.m in [0, 1, 2]));
    }

    // هل أتابع هذا المستخدم؟
    function followsUser(targetUid) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(targetUid));
    }

    // هل يحق لي قراءة هذا المنشور؟ منشور عام، أو منشوري، أو صاحبه حساب خاص وأتابعه.
    // authorPrivate يُكتب على المنشور عند إنشائه ويُزامَن عند تبديل خصوصية الحساب.
    // المنشورات القديمة التي لا تملك الحقل تُعامل كعامة إلى أن يُشغَّل سكربت الترحيل.
    function canReadPost(data) {
      return data.get('authorPrivate', false) == false
        || data.uid == request.auth.uid
        || followsUser(data.uid);
    }

    // قراءة المنشور الأب (للتعليقات والإعجابات).
    function parentPostReadable(postId) {
      return canReadPost(get(/databases/$(database)/documents/posts/$(postId)).data);
    }

    // الإعجابات المخفية وقوائم الإعجاب: لا تُعرض إلا إذا سمح صاحبها وكان ملفه مرئياً لي.
    function canViewLikes(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.get('hideLikes', false) != true
        && (!isPrivateUser(uid) || followsUser(uid));
    }

    // الإعجاب يغيّر العدّاد فقط إذا تغيّر مستند الإعجاب الحقيقي في العملية نفسها.
    function likeDocPath(postId) {
      return /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid);
    }

    // رسالة محفوظة: نسخة من رسالة حقيقية في محادثة يشارك فيها الحافظ.
    // الحقول اختيارية (حسب نوع الرسالة) والمعرّف = معرّف الرسالة الأصلية.
    function validSavedMessageCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'conversationId', 'senderUid', 'text', 'kind', 'createdAt', 'savedAt',
          'imageUrl', 'shareType', 'shareId', 'shareSubtitle', 'shareImage',
          'shareLink', 'lat', 'lng'
        ])
        && data.keys().hasAll([
          'conversationId', 'senderUid', 'text', 'kind', 'createdAt', 'savedAt'
        ])
        && data.conversationId is string
        && data.conversationId.size() > 0
        && data.conversationId.size() <= 1500
        && data.senderUid is string
        && data.text is string
        && data.text.size() > 0
        && data.text.size() <= 2000
        && data.kind in ['text', 'sticker', 'image', 'share', 'location']
        && data.createdAt is timestamp
        && data.createdAt <= request.time
        && data.savedAt == request.time
        // الموقع: الإحداثيان معاً أو لا شيء، وضمن النطاق الصالح.
        && ((!('lat' in data) && !('lng' in data))
          || ('lat' in data && 'lng' in data
            && data.lat >= -90 && data.lat <= 90
            && data.lng >= -180 && data.lng <= 180))
        && (!('imageUrl' in data)
          || (data.imageUrl is string && data.imageUrl.size() <= 1000))
        && (!('shareType' in data) || data.shareType in ['post', 'profile'])
        && (!('shareId' in data)
          || (data.shareId is string && data.shareId.size() <= 128))
        && (!('shareSubtitle' in data)
          || (data.shareSubtitle is string && data.shareSubtitle.size() <= 1000))
        && (!('shareImage' in data)
          || (data.shareImage is string && data.shareImage.size() <= 1000))
        && (!('shareLink' in data)
          || (data.shareLink is string && data.shareLink.size() <= 1000))
        // لا يُحفظ إلا من محادثة أنا مشارك فيها.
        && request.auth.uid in
          getAfter(/databases/$(database)/documents/chats/$(data.conversationId)).data.participants;
    }

    function validNotificationCreate(ownerUid, notificationId) {
      let data = request.resource.data;
      let actorUid = request.auth.uid;
      return data.actorUid == actorUid
        && actorUid != ownerUid
        && data.actorUsername is string
        && data.actorUsername.size() <= 24
        && get(/databases/$(database)/documents/users/$(actorUid)).data.username
          == data.actorUsername
        && data.read == false
        && data.createdAt == request.time
        && (
          (data.type == 'follow'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'read', 'createdAt'])
            && notificationId == 'follow_' + actorUid
            && existsAfter(/databases/$(database)/documents/users/$(ownerUid)/followers/$(actorUid))
            && followsAfter(actorUid, ownerUid))
          ||
          (data.type == 'followRequest'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'read', 'createdAt'])
            && notificationId == 'followRequest_' + actorUid
            && existsAfter(/databases/$(database)/documents/users/$(ownerUid)/followRequests/$(actorUid)))
          ||
          (data.type == 'followAccepted'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'read', 'createdAt'])
            && notificationId == 'followAccepted_' + actorUid
            && existsAfter(/databases/$(database)/documents/users/$(ownerUid)/following/$(actorUid)))
          ||
          (data.type == 'like'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'postId', 'read', 'createdAt'])
            && data.postId is string
            && notificationId == 'like_' + data.postId + '_' + actorUid
            && get(/databases/$(database)/documents/posts/$(data.postId)).data.uid == ownerUid
            && existsAfter(/databases/$(database)/documents/posts/$(data.postId)/likes/$(actorUid)))
          ||
          (data.type == 'comment'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'postId', 'commentId', 'commentText', 'read', 'createdAt'])
            && data.postId is string
            && data.commentId is string
            && data.commentText is string
            && data.commentText.size() > 0
            && data.commentText.size() <= 500
            && notificationId == 'comment_' + data.commentId
            && get(/databases/$(database)/documents/posts/$(data.postId)).data.uid == ownerUid
            && getAfter(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId)).data.uid == actorUid
            && getAfter(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId)).data.text == data.commentText)
        );
    }

      // يسمح للمستخدم بقراءة حالة حظره فقط حتى يسجّل التطبيق خروجه؛ لا يستطيع العميل تعديلها.
      match /blockedUsers/{uid} {
        allow get: if request.auth != null
          && (request.auth.uid == uid || isAdmin());
        allow list: if isAdmin();
        // الحظر من لوحة التحكم بدون Cloud Functions: الأدمن وحده ينشئ/يحذف مستند الحظر.
        // وبمجرد وجوده ترفض القواعد كل عمليات المستخدم (isActiveUser) ويُخرجه التطبيق فوراً.
        allow create: if isAdmin()
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'blockedBy', 'blockedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.blockedBy == request.auth.uid
          && request.resource.data.blockedAt == request.time;
        allow delete: if isAdmin();
        allow update: if false;
      }

    // الملاحظات القصيرة (مثل Notes في إنستغرام): مستند واحد لكل مستخدم يختفي بعد 24 ساعة.
    // viewers = أصدقاء صاحب الملاحظة (متابعة متبادلة) وقت النشر؛ الاستعلام يحمل
    // where('viewers', arrayContains: uid) فتستطيع القواعد إثبات أن كل نتيجة مسموحة.
    // انتهاء الصلاحية = createdAt + 24 ساعة يُحسب في العميل من وقت الخادم.
    match /notes/{uid} {
      allow get: if isActiveUser() && request.auth.uid == uid;
      allow read: if isActiveUser()
        && resource.data.viewers is list
        && request.auth.uid in resource.data.viewers;
      allow read, delete: if isAdmin();
      allow create, update: if isActiveUser()
        && request.auth.uid == uid
        && (
          // نشر ملاحظة جديدة (تستبدل القديمة).
          (request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt', 'viewers'])
            && request.resource.data.uid == uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 240
            && request.resource.data.createdAt == request.time
            && request.resource.data.viewers is list
            && request.resource.data.viewers.size() <= 1000
            && !request.resource.data.viewers.hasAny([uid]))
          ||
          // إخفاء الملاحظة الحالية عن مستخدم (عند حظره): قائمة المشاهدين تنقص فقط.
          (resource != null
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
            && request.resource.data.viewers is list
            && request.resource.data.viewers.size() < resource.data.viewers.size())
        );
      allow delete: if isActiveUser() && request.auth.uid == uid;
    }

    match /posts/{postId} {
      // الحساب الخاص: منشوراته لصاحبه ولمتابعيه فقط (تُفرض هنا في الخادم لا في الواجهة).
      // قواعد القراءة ليست فلتراً: استعلامات القوائم يجب أن تحمل where('authorPrivate', '==', false)
      // أو تقيّد uid بنفسي/بمن أتابعه، وإلا يرفضها Firestore كاملة.
      allow read: if isActiveUser()
        && (isAdmin() || canReadPost(resource.data));
      // الزائر: منشورات الحسابات العامة فقط (الاستعلامات تحمل where authorPrivate == false).
      allow read: if isGuest()
        && resource.data.get('authorPrivate', false) == false;
      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 500
        // رابط الوسائط: فارغ (وضع التجربة) أو https وبطول معقول فقط.
        && (request.resource.data.get('mediaUrl', null) == null
            || (request.resource.data.mediaUrl is string
                && request.resource.data.mediaUrl.size() <= 1000
                && request.resource.data.mediaUrl.matches('^https://[^ ]+$')))
        // الألبوم: قائمة بحد أقصى 10 روابط (يطابق PostService.maxAlbumImages).
        && (!('albumUrls' in request.resource.data)
            || (request.resource.data.albumUrls is list
                && request.resource.data.albumUrls.size() <= 10))
        && request.resource.data.likes == 0
        && request.resource.data.get('comments', 0) == 0
        && request.resource.data.get('views', 0) == 0
        && request.resource.data.get('shares', 0) == 0
        && authorMatchesProfile()
        && request.resource.data.authorPrivate is bool
        && request.resource.data.authorPrivate == (myProfile().get('isPrivate', false) == true)
        && (!('videoId' in request.resource.data)
            || (request.resource.data.videoId is string
                && request.resource.data.videoId.matches('^[A-Za-z0-9_-]{1,80}$')
                && ((!('videoProvider' in request.resource.data)
                      && request.resource.data.videoId.matches('^[A-Za-z0-9_-]{11}$'))
                    || (request.resource.data.videoProvider in
                          ['facebook', 'file', 'hls']
                        && request.resource.data.videoUrl is string
                        && request.resource.data.videoUrl.size() <= 600
                        && request.resource.data.videoUrl.matches('^https://[^ ]+$')
                        && !(request.resource.data.videoProvider == 'facebook'
                             && request.resource.data.videoUrl.matches('^https://www\\.facebook\\.com/reel/.*'))))))
        // استطلاع القصة: سؤال وخياران (نص قصير)، للقصص فقط.
        && (!('poll' in request.resource.data)
            || (request.resource.data.type == 'story'
                && request.resource.data.poll is map
                && request.resource.data.poll.keys().hasOnly(['q', 'a', 'b', 'x', 'y', 's', 'ar'])
                && request.resource.data.poll.q is string
                && request.resource.data.poll.q.size() > 0
                && request.resource.data.poll.q.size() <= 100
                && request.resource.data.poll.a is string
                && request.resource.data.poll.a.size() > 0
                && request.resource.data.poll.a.size() <= 40
                && request.resource.data.poll.b is string
                && request.resource.data.poll.b.size() > 0
                && request.resource.data.poll.b.size() <= 40
                && validStoryPos(request.resource.data.poll)))
        // صندوق أسئلة القصة: عبارة قصيرة، للقصص فقط.
        && (!('question' in request.resource.data)
            || (request.resource.data.type == 'story'
                && request.resource.data.question is map
                && request.resource.data.question.keys().hasOnly(['q', 'x', 'y', 's', 'ar'])
                && request.resource.data.question.q is string
                && request.resource.data.question.q.size() > 0
                && request.resource.data.question.q.size() <= 100
                && validStoryPos(request.resource.data.question)))
        // شريط إيموجي القصة: سؤال اختياري (قصير) وإيموجي، للقصص فقط.
        && (!('slider' in request.resource.data)
            || (request.resource.data.type == 'story'
                && request.resource.data.slider is map
                && request.resource.data.slider.keys().hasOnly(['q', 'e', 'x', 'y', 's', 'ar'])
                && request.resource.data.slider.q is string
                && request.resource.data.slider.q.size() <= 100
                && request.resource.data.slider.e is string
                && request.resource.data.slider.e.size() > 0
                && request.resource.data.slider.e.size() <= 16
                && validStoryPos(request.resource.data.slider)))
        // معلومات القصة: للقصص فقط.
        && validStoryInfo(request.resource.data)
        && (request.resource.data.type == 'story'
            || !hasStoryInfo(request.resource.data))
        // ذكر المستخدمين في القصة: حتى 3، للقصص فقط.
        && (!('mentions' in request.resource.data)
            || (request.resource.data.type == 'story'
                && request.resource.data.mentions is list
                && request.resource.data.mentions.size() <= 3));
      // المالك يعدّل نص المنشور فقط. أي مستخدم مسجّل يستطيع:
      //  - الإعجاب/إلغاؤه: العدّاد يتغيّر بمقدار 1 فقط وبالتزامن مع إنشاء/حذف مستند إعجابه هو.
      //  - زيادة/إنقاص عدّاد التعليقات بمقدار 1، وزيادة المشاركات بمقدار 1.
      allow update: if isActiveUser() && (
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption'])
          && request.resource.data.caption is string
          && request.resource.data.caption.size() <= 500) ||
        // المنشور النصي: المالك يعدّل النص والخلفية الملونة ولون النص (أرقام فقط).
        (resource.data.uid == request.auth.uid
          && resource.data.type == 'text'
          && request.resource.data.type == 'text'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'tbg', 'tc'])
          && request.resource.data.caption is string
          && request.resource.data.caption.size() <= 500
          && (!('tbg' in request.resource.data)
              || (request.resource.data.tbg is int
                  && request.resource.data.tbg >= 0 && request.resource.data.tbg < 100))
          && (!('tc' in request.resource.data)
              || (request.resource.data.tc is int
                  && request.resource.data.tc >= 0 && request.resource.data.tc < 100))) ||
        // إضافة صور لمنشور نصي: يتحوّل إلى منشور صورة (أو ألبوم) وتُزال الخلفية ولون النص.
        (resource.data.uid == request.auth.uid
          && resource.data.type == 'text'
          && request.resource.data.type == 'photo'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type', 'caption', 'mediaUrl', 'albumUrls', 'mime', 'tbg', 'tc'])
          && request.resource.data.caption is string
          && request.resource.data.caption.size() <= 500
          && request.resource.data.mediaUrl is string
          && request.resource.data.mediaUrl.size() <= 1000
          && request.resource.data.mediaUrl.matches('^https://[^ ]+$')
          && (!('albumUrls' in request.resource.data)
              || (request.resource.data.albumUrls is list
                  && request.resource.data.albumUrls.size() <= 10))
          && !('tbg' in request.resource.data)
          && !('tc' in request.resource.data)) ||
        // مزامنة authorPrivate عند تبديل خصوصية حسابي (يجب أن تطابق ملفي الحالي).
        (resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorPrivate'])
          && request.resource.data.authorPrivate is bool
          && request.resource.data.authorPrivate == (myProfile().get('isPrivate', false) == true)) ||
        // التفاعل (إعجاب/تعليق/مشاركة) لمن يحق له رؤية المنشور فقط.
        (canReadPost(resource.data) && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && (
              (request.resource.data.likes == resource.data.likes + 1
                && !exists(likeDocPath(postId))
                && existsAfter(likeDocPath(postId)))
              ||
              (request.resource.data.likes == resource.data.likes - 1
                && exists(likeDocPath(postId))
                && !existsAfter(likeDocPath(postId)))
            )) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
            && request.resource.data.comments is int
            && request.resource.data.comments >= 0
            && (request.resource.data.comments == resource.data.get('comments', 0) + 1
              || request.resource.data.comments < resource.data.get('comments', 0))) ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares'])
            && request.resource.data.shares == resource.data.get('shares', 0) + 1)
        )) ||
        // لوحة التحكم: تنقيص عدّاد التعليقات عند حذف تعليق مُبلَّغ عنه.
        (isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && request.resource.data.comments is int
          && request.resource.data.comments >= 0
          && request.resource.data.comments < resource.data.get('comments', 0))
      );
      // لوحة التحكم عند حذف حساب: إنقاص عدّاد إعجابات المنشورات التي أعجب بها المحذوف.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes is int
        && request.resource.data.likes >= 0
        && request.resource.data.likes < resource.data.likes;
      allow delete: if isActiveUser()
        && (isAdmin() || resource.data.uid == request.auth.uid);

      match /likes/{uid} {
        // مستند إعجابي أنا يُقرأ دائماً (بلا قراءة إضافية)، وإعجابات غيري تتبع قابلية قراءة المنشور.
        allow read: if isActiveUser()
          && (request.auth.uid == uid || parentPostReadable(postId));
        allow write: if isActiveUser() && request.auth.uid == uid;
        // صاحب المنشور (القصة) يحذف إعجاباتها عند حذفها.
        allow delete: if isActiveUser()
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
        // لوحة التحكم: قراءة/حذف الإعجابات عند حذف منشور أو حساب.
        allow read: if isAdmin();
        allow delete: if isAdmin();
      }

      // مشاهدات القصص: كل مشاهد يسجّل نفسه فقط (وقت الخادم)، ويقرؤها صاحب القصة وحده.
      match /views/{viewerUid} {
        allow read: if isActiveUser()
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
        allow create, update: if isActiveUser()
          && request.auth.uid == viewerUid
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid != viewerUid
          && request.resource.data.keys().hasOnly(['at', 'e'])
          && request.resource.data.at == request.time
          && validViewReaction(request.resource.data);
        // لوحة التحكم: قراءة/حذف المشاهدات عند حذف منشور (قصة).
        allow read: if isAdmin();
        allow delete: if isAdmin();
        // صاحب القصة يحذف مشاهداتها عند حذفها (قبل حذف القصة نفسها).
        allow delete: if isActiveUser()
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
      }

      // أصوات استطلاع القصة: كل مستخدم يصوّت مرة واحدة لنفسه فقط (بلا تعديل)،
      // ولا يصوّت صاحب القصة. القراءة لمن يستطيع قراءة القصة (لعدّ النتائج).
      match /votes/{voterUid} {
        allow read: if isActiveUser()
          && (isAdmin() || parentPostReadable(postId));
        allow create: if isActiveUser()
          && request.auth.uid == voterUid
          && parentPostReadable(postId)
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid != voterUid
          && get(/databases/$(database)/documents/posts/$(postId)).data.get('poll', null) != null
          && request.resource.data.keys().hasOnly(['choice', 'at'])
          && request.resource.data.choice in [0, 1]
          && request.resource.data.at == request.time;
        // لوحة التحكم: حذف الأصوات عند حذف منشور.
        allow delete: if isAdmin();
        // صاحب القصة يحذف أصواتها عند حذفها.
        allow delete: if isActiveUser()
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
      }

      // تقييمات شريط الإيموجي: تقييم واحد لكل مستخدم لنفسه فقط (بلا تعديل)،
      // ولا يقيّم صاحب القصة. القراءة لمن يقرأ القصة (لحساب المتوسط).
      match /sliderVotes/{voterUid} {
        allow read: if isActiveUser() && (isAdmin() || parentPostReadable(postId));
        allow create: if isActiveUser()
          && request.auth.uid == voterUid
          && parentPostReadable(postId)
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid != voterUid
          && get(/databases/$(database)/documents/posts/$(postId)).data.get('slider', null) != null
          && request.resource.data.keys().hasOnly(['v', 'at'])
          && request.resource.data.v is int
          && request.resource.data.v >= 0
          && request.resource.data.v <= 100
          && request.resource.data.at == request.time;
        allow delete: if isAdmin();
        allow delete: if isActiveUser()
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
      }

      // إجابات صندوق أسئلة القصة: كل مستخدم يجيب مرة واحدة لنفسه فقط (بلا تعديل)،
      // ولا يجيب صاحب القصة. يقرؤها صاحب القصة، ويقرأ المجيب إجابته فقط.
      match /answers/{responderUid} {
        allow read: if isActiveUser()
          && (isAdmin()
              || request.auth.uid == responderUid
              || get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid);
        allow create: if isActiveUser()
          && request.auth.uid == responderUid
          && parentPostReadable(postId)
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid != responderUid
          && get(/databases/$(database)/documents/posts/$(postId)).data.get('question', null) != null
          && request.resource.data.keys().hasOnly(['username', 'name', 'text', 'at'])
          && request.resource.data.username is string
          && request.resource.data.username == myProfile().username
          && request.resource.data.name is string
          && (request.resource.data.name == myProfile().name
              || request.resource.data.name == myProfile().username)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.at == request.time;
        allow delete: if isAdmin();
        // صاحب القصة يحذف الإجابات عند حذفها.
        allow delete: if isActiveUser()
          && get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid;
      }

      // التعليقات: يكتبها أي مستخدم مسجّل، ويحذفها صاحبها أو صاحب المنشور
      match /comments/{commentId} {
        allow read: if isActiveUser()
          && (isAdmin() || parentPostReadable(postId));
        // الزائر يقرأ تعليقات المنشورات العامة فقط.
        allow read: if isGuest()
          && get(/databases/$(database)/documents/posts/$(postId)).data.get('authorPrivate', false) == false;
        allow create: if isActiveUser()
          && parentPostReadable(postId)
          && request.resource.data.uid == request.auth.uid
          && authorMatchesProfile()
          && request.resource.data.get('likedBy', []) == []
          && request.resource.data.createdAt == request.time
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.get('kind', 'text') in ['text', 'sticker', 'image']
          // الردود: مستوى واحد فقط؛ الأب موجود وليس ردّاً بدوره.
          && (!('parentId' in request.resource.data)
            || (request.resource.data.parentId is string
              && request.resource.data.parentId.size() > 0
              && request.resource.data.parentId.size() <= 40
              && exists(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId))
              && !('parentId' in get(/databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.parentId)).data)))
          && (!('replyToUsername' in request.resource.data)
            || ('parentId' in request.resource.data
              && request.resource.data.replyToUsername is string
              && request.resource.data.replyToUsername.size() <= 24))
          && (!('image' in request.resource.data)
            || (request.resource.data.kind == 'image'
              && request.resource.data.image is bytes
              && request.resource.data.image.size() <= 716800));
        allow update: if isActiveUser()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy'])
          && request.resource.data.likedBy is list
          && request.resource.data.likedBy.size()
            <= resource.data.get('likedBy', []).size() + 1
          && request.resource.data.likedBy.size()
            >= resource.data.get('likedBy', []).size() - 1
          && (
            (request.resource.data.likedBy.hasAll(
                resource.data.get('likedBy', [])
              )
              && request.resource.data.likedBy.size()
                == resource.data.get('likedBy', []).size() + 1
              && !resource.data.get('likedBy', []).hasAny([request.auth.uid])
              && request.resource.data.likedBy.hasAny([request.auth.uid]))
            ||
            (resource.data.get('likedBy', []).hasAll(
                request.resource.data.likedBy
              )
              && request.resource.data.likedBy.size()
                == resource.data.get('likedBy', []).size() - 1
              && resource.data.get('likedBy', []).hasAny([request.auth.uid])
              && !request.resource.data.likedBy.hasAny([request.auth.uid]))
          );
        // لوحة التحكم عند حذف حساب: إزالة إعجابه من التعليقات (تنقيص likedBy فقط).
        allow update: if isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
          && request.resource.data.likedBy is list
          && request.resource.data.likedBy.size()
            < resource.data.get('likedBy', []).size();
        allow delete: if isActiveUser() && (
          isAdmin() ||
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid ||
          // صاحب التعليق الأب يحذف الردود عليه عند حذف تعليقه.
          ('parentId' in resource.data
            && get(/databases/$(database)/documents/posts/$(postId)/comments/$(resource.data.parentId)).data.uid == request.auth.uid)
        );
      }
    }

    match /chats/{chatId} {
      function isParticipant() {
        return isActiveUser()
          && request.auth.uid in resource.data.participants;
      }

      // حقل خريطة (readAt / deliveredAt / clearedAt) يخص المستخدم الحالي فقط:
      // لا يتغير فيه إلا مدخله، وقيمته وقت صالح لا يتجاوز الآن ولا يتراجع.
      function touchesOnlyMine(field) {
        let before = resource.data.get(field, {});
        let after = request.resource.data[field];
        return after is map
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && after[request.auth.uid] is timestamp
          && after[request.auth.uid] <= request.time
          && (!(request.auth.uid in before)
            || after[request.auth.uid] > before[request.auth.uid]);
      }

      // علَم true/false يخص المستخدم الحالي فقط (pinned / muted).
      function touchesOnlyMyFlag(field) {
        let before = resource.data.get(field, {});
        let after = request.resource.data[field];
        return after is map
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && after[request.auth.uid] is bool;
      }

      // وقت يخص المستخدم الحالي فقط (mutedUntil): مدخل واحد بقيمة timestamp.
      function touchesOnlyMyTimestamp(field) {
        let before = resource.data.get(field, {});
        let after = request.resource.data[field];
        return after is map
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
          && after[request.auth.uid] is timestamp;
      }

      // حظر طرفَي المحادثة الثنائية فقط؛ المجموعات لا يوقفها حظر فردي.
      function pairBlocked() {
        return resource.data.get('isGroup', false) != true
          && isBlocked(
            resource.data.participants[0],
            resource.data.participants[1]
          );
      }

      // لا نسمح بقراءة مستند غير موجود (كان يكشف هل تراسل مستخدمان أم لا):
      // البدء يتم بالإنشاء ثم القراءة من الطرفين فقط.
      // الأدمن يقرأ ملخصات المحادثات للوحة التحكم؛ الرسائل الفرعية تبقى للمشاركين فقط.
      allow get: if isAdmin() || isParticipant();
      allow list: if isAdmin() || isParticipant();
      allow create: if isActiveUser()
        && (
          (
            request.resource.data.keys().hasOnly([
              'participants', 'lastMessage', 'lastSenderUid', 'lastMessageId',
              'createdAt', 'updatedAt', 'accepted'
            ])
            && request.resource.data.participants is list
            && request.resource.data.participants.size() == 2
            && request.resource.data.participants.hasAny([request.auth.uid])
            && request.resource.data.participants[0] is string
            && request.resource.data.participants[1] is string
            && request.resource.data.participants[0] < request.resource.data.participants[1]
            // المعرّف يجب أن يطابق المعرّف المحسوب من الطرفين، لمنع حجز معرّف محادثة غيرك.
            && chatId == string(request.resource.data.participants[0].size()) + '_'
              + request.resource.data.participants[0]
              + string(request.resource.data.participants[1].size()) + '_'
              + request.resource.data.participants[1]
            && !isBlocked(
              request.resource.data.participants[0],
              request.resource.data.participants[1]
            )
            && request.resource.data.lastMessage == ''
            && request.resource.data.lastSenderUid == ''
            && request.resource.data.lastMessageId == ''
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            // كل محادثة جديدة تبدأ «غير مقبولة»؛ تُفتح عند ردّ الطرف الآخر.
            && request.resource.data.accepted == false
          )
          ||
          // مجموعة: معرّف عشوائي، اسم ومشرفون، ومقبولة دائماً (لا طلب رسالة).
          (request.resource.data.get('isGroup', false) == true
            && request.resource.data.keys().hasOnly([
              'participants', 'isGroup', 'groupName', 'groupPhoto',
              'createdBy', 'admins', 'lastMessage', 'lastSenderUid',
              'lastMessageId', 'accepted', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.keys().hasAll([
              'participants', 'isGroup', 'groupName', 'createdBy', 'admins'
            ])
            && request.resource.data.participants is list
            && request.resource.data.participants.size() >= 3
            && request.resource.data.participants.size() <= 250
            && request.resource.data.participants.hasAny([request.auth.uid])
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.admins is list
            && request.resource.data.admins == [request.auth.uid]
            && request.resource.data.groupName is string
            && request.resource.data.groupName.size() > 0
            && request.resource.data.groupName.size() <= 60
            && (!('groupPhoto' in request.resource.data)
              || (request.resource.data.groupPhoto is string
                && request.resource.data.groupPhoto.size() <= 1000))
            && request.resource.data.lastMessage == ''
            && request.resource.data.lastSenderUid == ''
            && request.resource.data.lastMessageId == ''
            && request.resource.data.createdAt == request.time
            && request.resource.data.updatedAt == request.time
            && request.resource.data.accepted == true)
        );
      allow update: if isActiveUser()
        && resource.data.participants is list
        && resource.data.participants.hasAny([request.auth.uid])
        && (
          (!pairBlocked()
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'lastMessage', 'lastSenderUid', 'lastMessageId', 'updatedAt',
                'accepted', 'startedBy'
              ])
            // «startedBy»: قائمة بمن أرسل رسالة افتتاحية في هذه المحادثة. لا
            // تُمسح بحذف الرسالة، فلا يمكن تكرار «أرسل ثم احذف» لتجاوز حدّ
            // الرسالة الواحدة لغير الأصدقاء. تزيد بإضافة مدخل واحد: أنا فقط.
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['startedBy'])
              || (request.resource.data.startedBy is list
                && request.resource.data.startedBy
                  .hasAll(resource.data.get('startedBy', []))
                && request.resource.data.startedBy.hasAny([request.auth.uid])
                && request.resource.data.startedBy.size()
                  <= resource.data.get('startedBy', []).size() + 1
                && request.resource.data.startedBy.size() <= 2))
            // «accepted» لا يتغير إلا من false إلى true، ومن الطرف الذي ردّ على
            // رسالة الطرف الآخر (آخر مرسل قبل هذه الكتابة ليس أنا).
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['accepted'])
              || (resource.data.get('accepted', true) == false
                && request.resource.data.accepted == true
                && resource.data.lastSenderUid != ''
                && resource.data.lastSenderUid != request.auth.uid))
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 2000
            && request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessageId is string
            && request.resource.data.lastMessageId.size() > 0
            && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderUid
              == request.auth.uid
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text
              == request.resource.data.lastMessage
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.createdAt
              == request.time)
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'lastMessage', 'lastSenderUid', 'lastMessageId', 'updatedAt'
              ])
            && resource.data.lastMessageId is string
            && resource.data.lastMessageId.size() > 0
            && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId))
            && get(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId)).data.senderUid
              == request.auth.uid
            && !existsAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId))
            && (
              (request.resource.data.lastMessage == ''
                && request.resource.data.lastSenderUid == ''
                && request.resource.data.lastMessageId == ''
                && request.resource.data.updatedAt == request.time)
              ||
              // بعد حذف آخر رسالة يعود updatedAt إلى وقت الرسالة السابقة نفسها
              // (لا إلى الآن)، فلا تظهر المحادثة «غير مقروءة» ولا تقفز للأعلى.
              (request.resource.data.lastMessage is string
                && request.resource.data.lastMessage.size() > 0
                && request.resource.data.lastMessage.size() <= 2000
                && request.resource.data.lastSenderUid is string
                && request.resource.data.lastMessageId is string
                && request.resource.data.lastMessageId.size() > 0
                && request.resource.data.lastMessageId
                  != resource.data.lastMessageId
                && existsAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId))
                && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text
                  == request.resource.data.lastMessage
                && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderUid
                  == request.resource.data.lastSenderUid
                && request.resource.data.updatedAt
                  == getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.createdAt))
          )
          ||
          // تعديل نص آخر رسالة (رسالتي): يتغير lastMessage وحده ليطابق النص
          // الجديد، دون المساس بـ updatedAt فلا تقفز المحادثة ولا تصبح «غير مقروءة».
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastMessage'])
            && !pairBlocked()
            && resource.data.lastMessageId is string
            && resource.data.lastMessageId.size() > 0
            && resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 2000
            && get(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId)).data.senderUid
              == request.auth.uid
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId)).data.text
              == request.resource.data.lastMessage)
          ||
          // إيصالات المحادثة ومسحها لديّ: كل مستخدم يكتب مدخله فقط.
          // readAt = وقت آخر رسالة قرأتها، deliveredAt = آخر رسالة وصلتني،
          // clearedAt = «حذف المحادثة لديّ» (يخفي ما قبله عني فقط).
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['readAt', 'deliveredAt', 'clearedAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['readAt'])
              || touchesOnlyMine('readAt'))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['deliveredAt'])
              || touchesOnlyMine('deliveredAt'))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['clearedAt'])
              || (touchesOnlyMine('clearedAt')
                && request.resource.data.clearedAt[request.auth.uid]
                  == request.time)))
          ||
          // قبول طلب رسالة بلا ردّ: يقلب accepted من false إلى true فقط، لمن
          // وصلته رسالة الطرف الآخر ولم يردّ بعد (كإنستغرام).
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['accepted'])
            && !pairBlocked()
            && resource.data.get('accepted', true) == false
            && request.resource.data.accepted == true
            && resource.data.lastSenderUid != ''
            && resource.data.lastSenderUid != request.auth.uid)
          ||
          // تثبيت المحادثة وكتمها لديّ: خرائط pinned / muted / mutedUntil، كل
          // مستخدم يكتب مدخله فقط (mutedUntil = كتم مؤقت ينتهي بوقته).
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pinned', 'muted', 'mutedUntil'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['pinned'])
              || touchesOnlyMyFlag('pinned'))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['muted'])
              || touchesOnlyMyFlag('muted'))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['mutedUntil'])
              || touchesOnlyMyTimestamp('mutedUntil')))
          ||
          // أرشفة المحادثة لديّ: خريطتا archived / archivedAt، كل مستخدم يكتب
          // مدخله فقط، و archivedAt بوقت الخادم الحالي.
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['archived', 'archivedAt'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['archived'])
              || touchesOnlyMyFlag('archived'))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['archivedAt'])
              || (touchesOnlyMine('archivedAt')
                && request.resource.data.archivedAt[request.auth.uid]
                  == request.time)))
          ||
          // رسالة مثبّتة داخل المحادثة (يراها الطرفان): معرّف رسالة موجودة في
          // المحادثة نفسها، أو نص فارغ لإلغاء التثبيت.
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['pinnedMessageId'])
            && !pairBlocked()
            && request.resource.data.pinnedMessageId is string
            && request.resource.data.pinnedMessageId.size() <= 128
            && (request.resource.data.pinnedMessageId == ''
              || exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.pinnedMessageId))))
          ||
          // «يكتب الآن»: خريطة typing، كل مستخدم يكتب مدخله فقط، إمّا بوقت الخادم
          // الحالي أو بحذف مدخله. لا تغيّر أي حقل آخر ولا تعمل مع الحظر.
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['typing'])
            && !pairBlocked()
            && request.resource.data.get('typing', {}) is map
            && request.resource.data.get('typing', {})
              .diff(resource.data.get('typing', {})).affectedKeys()
              .hasOnly([request.auth.uid])
            && (!(request.auth.uid in request.resource.data.get('typing', {}))
              || request.resource.data.typing[request.auth.uid]
                == request.time))
          ||
          // إدارة المجموعة (اسم/صورة/أعضاء/مشرفون): يقبلها مشرف فقط، مع بقاء
          // المنشئ عضواً، وحدّ أعلى للأعضاء.
          (resource.data.get('isGroup', false) == true
            && (resource.data.get('createdBy', '') == request.auth.uid
              || request.auth.uid in resource.data.get('admins', []))
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'groupName', 'groupPhoto', 'admins'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['participants'])
              || (request.resource.data.participants is list
                && request.resource.data.participants.size() >= 2
                && request.resource.data.participants.size() <= 250
                && request.resource.data.participants.hasAny([request.auth.uid])
                && request.resource.data.participants
                  .hasAll([resource.data.get('createdBy', '')])))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['groupName'])
              || (request.resource.data.groupName is string
                && request.resource.data.groupName.size() > 0
                && request.resource.data.groupName.size() <= 60))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['groupPhoto'])
              || (request.resource.data.groupPhoto is string
                && request.resource.data.groupPhoto.size() <= 1000))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['admins'])
              || (request.resource.data.admins is list
                && request.resource.data.admins.size() <= 250
                && request.resource.data.admins
                  .hasAll([resource.data.get('createdBy', '')]))))
          ||
          // مغادرة المجموعة: العضو يزيل نفسه من الأعضاء والمشرفين فقط.
          (resource.data.get('isGroup', false) == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['participants', 'admins'])
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['participants'])
              || (request.resource.data.participants is list
                && request.resource.data.participants.toSet()
                  == resource.data.participants.toSet()
                    .difference([request.auth.uid].toSet())))
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['admins'])
              || (request.resource.data.admins is list
                && request.resource.data.admins.toSet()
                  == resource.data.admins.toSet()
                    .difference([request.auth.uid].toSet()))))
        );
      // لوحة التحكم عند حذف حساب: حذف المحادثة (الرسائل الفرعية تبقى غير قابلة للقراءة).
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function isChatParticipant() {
          return isActiveUser()
            && request.auth.uid in
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        function chatNow() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function chatNext() {
          return getAfter(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        // حظر طرفَي المحادثة الثنائية فقط؛ المجموعات لا يوقفها حظر فردي.
        function chatPairBlocked() {
          return chatNow().get('isGroup', false) != true
            && isBlocked(
              chatNow().participants[0],
              chatNow().participants[1]
            );
        }
        function validReactionUpdate() {
          let before = resource.data.get('reactions', {});
          let after = request.resource.data.get('reactions', {});
          let uid = request.auth.uid;
          return after is map
            && after.keys().hasOnly(chatNow().participants)
            && after.diff(before).affectedKeys().hasOnly([uid])
            && (!(uid in after)
              || (after[uid] is string
                && after[uid].size() > 0
                && after[uid].size() <= 8));
        }
        // متابعة متبادلة بين طرفي المحادثة.
        function areMutualFriends() {
          let p = chatNow().participants;
          let other = p[0] == request.auth.uid ? p[1] : p[0];
          return exists(/databases/$(database)/documents/users/$(request.auth.uid)/following/$(other))
            && exists(/databases/$(database)/documents/users/$(other)/following/$(request.auth.uid));
        }
        // من يحق له الإرسال الآن:
        // 1) محادثة مفتوحة (قديمة بلا الحقل، أو ردّ فيها الطرف الآخر)،
        // 2) أصدقاء (متابعة متبادلة)،
        // 3) أول رسالة لغريب: نص فقط، ولا رسائل قبلها،
        // 4) ردّ على آخر رسالة من الطرف الآخر (ويجب أن تصبح المحادثة مقبولة).
        function canSendNow() {
          return chatNow().get('accepted', true) == true
            || areMutualFriends()
            || (chatNow().lastMessageId == ''
              && request.resource.data.kind == 'text'
              // من افتتح المحادثة مرة (ولو حذف رسالته) لا يفتتحها ثانية.
              && !(request.auth.uid in chatNow().get('startedBy', [])))
            || (chatNow().lastMessageId != ''
              && chatNow().lastSenderUid != request.auth.uid
              && chatNext().get('accepted', true) == true);
        }

        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.keys().hasOnly([
            'senderUid', 'text', 'kind', 'image', 'imageUrl', 'deliveredTo',
            'readBy', 'createdAt', 'replyToMessageId', 'replyToText',
            'replyToSenderUid', 'forwarded', 'shareType', 'shareId',
            'shareSubtitle', 'shareImage', 'shareLink', 'lat', 'lng',
            'viewOnce', 'expiresAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderUid', 'text', 'kind', 'deliveredTo', 'readBy', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && (!('forwarded' in request.resource.data)
            || request.resource.data.forwarded == true)
          // «تُعرض مرة واحدة»: صور فقط.
          && (!('viewOnce' in request.resource.data)
            || (request.resource.data.viewOnce == true
              && request.resource.data.kind == 'image'))
          // وضع الاختفاء: وقت انتهاء صلاحية الرسالة.
          && (!('expiresAt' in request.resource.data)
            || request.resource.data.expiresAt is timestamp)
          && (!('shareType' in request.resource.data)
            || request.resource.data.shareType in ['post', 'profile', 'story'])
          && (!('shareId' in request.resource.data)
            || (request.resource.data.shareId is string
              && request.resource.data.shareId.size() <= 128))
          && (!('shareSubtitle' in request.resource.data)
            || (request.resource.data.shareSubtitle is string
              && request.resource.data.shareSubtitle.size() <= 1000))
          && (!('shareImage' in request.resource.data)
            || (request.resource.data.shareImage is string
              && request.resource.data.shareImage.size() <= 1000
              && request.resource.data.shareImage.matches('^https://.+$')))
          && (!('shareLink' in request.resource.data)
            || (request.resource.data.shareLink is string
              && request.resource.data.shareLink.size() <= 1000))
          && (!('replyToMessageId' in request.resource.data)
            || (request.resource.data.replyToMessageId is string
              && request.resource.data.replyToMessageId.size() > 0
              && request.resource.data.replyToMessageId.size() <= 128
              && request.resource.data.replyToText is string
              && request.resource.data.replyToText.size() <= 2000
              && request.resource.data.replyToSenderUid is string
              && request.resource.data.replyToSenderUid in chatNow().participants))
          && (
            (request.resource.data.kind == 'image'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'image', 'imageUrl',
                'deliveredTo', 'readBy', 'createdAt', 'replyToMessageId',
                'replyToText', 'replyToSenderUid', 'forwarded',
                'viewOnce', 'expiresAt'
              ])
              && (
                (('image' in request.resource.data)
                  && !('imageUrl' in request.resource.data)
                  && request.resource.data.image is bytes
                  && request.resource.data.image.size() <= 716800)
                ||
                (('imageUrl' in request.resource.data)
                  && !('image' in request.resource.data)
                  && request.resource.data.imageUrl is string
                  && request.resource.data.imageUrl.size() <= 1000
                  && request.resource.data.imageUrl.matches(
                    '^https://(res[.]cloudinary[.]com|firebasestorage[.]googleapis[.]com)/.+$'))
              ))
            ||
            (request.resource.data.kind == 'text'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'deliveredTo', 'readBy',
                'createdAt', 'replyToMessageId', 'replyToText',
                'replyToSenderUid', 'forwarded', 'expiresAt'
              ])
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.kind == 'sticker'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'deliveredTo', 'readBy',
                'createdAt', 'replyToMessageId', 'replyToText',
                'replyToSenderUid', 'forwarded', 'expiresAt'
              ])
              && request.resource.data.text.size() <= 24)
            ||
            // مشاركة غنية (بطاقة منشور/ملف شخصي): النوع مطلوب، بلا صورة مرفقة.
            (request.resource.data.kind == 'share'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'shareType', 'shareId',
                'shareSubtitle', 'shareImage', 'shareLink', 'deliveredTo',
                'readBy', 'createdAt', 'replyToMessageId', 'replyToText',
                'replyToSenderUid', 'forwarded', 'expiresAt'
              ])
              && ('shareType' in request.resource.data)
              && request.resource.data.text.size() <= 200)
            ||
            // موقع: إحداثيان صالحان، والنص اسم المكان (قصير).
            (request.resource.data.kind == 'location'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'lat', 'lng', 'deliveredTo',
                'readBy', 'createdAt', 'replyToMessageId', 'replyToText',
                'replyToSenderUid', 'forwarded', 'expiresAt'
              ])
              && request.resource.data.lat >= -90
              && request.resource.data.lat <= 90
              && request.resource.data.lng >= -180
              && request.resource.data.lng <= 180
              && request.resource.data.text.size() <= 200)
          )
          && !chatPairBlocked()
          && canSendNow()
          && request.resource.data.deliveredTo == [request.auth.uid]
          && request.resource.data.readBy == [request.auth.uid]
          && request.resource.data.createdAt == request.time
          && chatNext().lastSenderUid == request.auth.uid
          && chatNext().lastMessageId == messageId
          && (chatNext().get('accepted', true) == true
            || request.auth.uid in chatNext().get('startedBy', []))
          && chatNext().lastMessage == request.resource.data.text;
        allow update: if isChatParticipant()
          && (
            (resource.data.senderUid != request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['deliveredTo', 'readBy', 'viewedBy'])
              && request.resource.data.deliveredTo is list
              && request.resource.data.deliveredTo
                .hasAll(resource.data.get('deliveredTo', []))
              && request.resource.data.deliveredTo.hasAny([request.auth.uid])
              && request.resource.data.deliveredTo.size()
                <= resource.data.get('deliveredTo', []).size() + 1
              && request.resource.data.readBy is list
              && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
              && request.resource.data.readBy.hasAny([request.auth.uid])
              && request.resource.data.readBy.size()
                <= resource.data.get('readBy', []).size() + 1
              // «تُعرض مرة واحدة»: المستلم يضيف نفسه فقط لقائمة العرض.
              && (!('viewedBy' in request.resource.data)
                || (request.resource.data.viewedBy is list
                  && request.resource.data.viewedBy
                    .hasAll(resource.data.get('viewedBy', []))
                  && request.resource.data.viewedBy.hasAny([request.auth.uid])
                  && request.resource.data.viewedBy.size()
                    <= resource.data.get('viewedBy', []).size() + 1)))
            ||
            (request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions'])
              && validReactionUpdate())
            ||
            // تعديل نص رسالتي النصية خلال 15 دقيقة من إرسالها (يطابق
            // SocialService.messageEditWindow). يُسجَّل وقت التعديل editedAt.
            (resource.data.senderUid == request.auth.uid
              && resource.data.kind == 'text'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text', 'editedAt'])
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 2000
              && request.resource.data.text != resource.data.text
              && request.resource.data.editedAt == request.time
              && request.time < resource.data.createdAt + duration.value(15, 'm')
              && !chatPairBlocked())
          );
        allow delete: if isChatParticipant()
          && resource.data.senderUid == request.auth.uid;
      }

      // رسائل «حذف لديّ فقط»: مستند لكل مستخدم يخص نفسه فقط.
      match /hiddenMessages/{uid} {
        function isParticipantHere() {
          return isActiveUser()
            && request.auth.uid in
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if isParticipantHere() && request.auth.uid == uid;
        allow create, update: if isParticipantHere()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ids', 'updatedAt'])
          && request.resource.data.ids is list
          && request.resource.data.ids.size() <= 500
          && request.resource.data.updatedAt == request.time;
        allow delete: if isAdmin();
      }
    }

    match /userBlocks/{uid}/blocked/{otherUid} {
      allow read: if isActiveUser()
        && (request.auth.uid == uid || request.auth.uid == otherUid);
      allow create: if isActiveUser()
        && request.auth.uid == uid
        && uid != otherUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isActiveUser() && request.auth.uid == uid;
      // لوحة التحكم عند حذف حساب: قراءة/حذف قائمة حظره.
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // كتم القصص: قائمة خاصة بصاحبها وحده (من كتمتُ قصصهم).
    match /storyMutes/{owner}/muted/{target} {
      allow read: if isActiveUser() && (request.auth.uid == owner || isAdmin());
      allow create: if isActiveUser()
        && request.auth.uid == owner
        && target != owner
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow delete: if isActiveUser() && (request.auth.uid == owner || isAdmin());
    }

    // إخفاء قصصي عن أشخاص: يقرأ المستند صاحب القائمة أو الشخص المخفيّ عنه
    // (ليعرف تطبيقه أنه مُخفى عنه)؛ والقائمة الكاملة لصاحبها فقط.
    match /storyHidden/{owner}/hidden/{target} {
      allow get: if isActiveUser()
        && (request.auth.uid == owner || request.auth.uid == target || isAdmin());
      allow list: if isActiveUser() && (request.auth.uid == owner || isAdmin());
      allow create: if isActiveUser()
        && request.auth.uid == owner
        && target != owner
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow delete: if isActiveUser() && (request.auth.uid == owner || isAdmin());
    }

    // البلاغات: الإنشاء فقط من المستخدم المسجّل، والقراءة والحذف للأدمن فقط (لوحة التحكم).
    match /reports/{reportId} {
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly([
          'type', 'targetUid', 'reporterUid', 'reason', 'details', 'createdAt',
          'postId', 'commentId'
        ])
        && ((request.resource.data.type == 'user'
              && !('postId' in request.resource.data)
              && !('commentId' in request.resource.data))
            || (request.resource.data.type == 'post'
              && request.resource.data.postId is string
              && request.resource.data.postId.size() > 0
              && request.resource.data.postId.size() <= 40
              && !('commentId' in request.resource.data))
            || (request.resource.data.type == 'comment'
              && request.resource.data.postId is string
              && request.resource.data.postId.size() > 0
              && request.resource.data.postId.size() <= 40
              && request.resource.data.commentId is string
              && request.resource.data.commentId.size() > 0
              && request.resource.data.commentId.size() <= 40))
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason in [
          'spam', 'abuse', 'inappropriate', 'impersonation', 'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    match /presence/{uid} {
      allow read: if isActiveUser();
      allow create, update: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['online', 'updatedAt'])
        && request.resource.data.online is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if (isActiveUser() && request.auth.uid == uid) || isAdmin();
    }

    // قطع الملفات (وضع التجربة): كل قطعة تحمل uid صاحبها، لا تُعدَّل، ويحذفها صاحبها فقط
    // قائمة الأصدقاء المقربين: لصاحبها وحده (حتى 100 معرّف).
    match /closeFriends/{ownerUid} {
      allow read: if isActiveUser() && request.auth.uid == ownerUid;
      allow read, delete: if isAdmin();
      allow create, update: if isActiveUser()
        && request.auth.uid == ownerUid
        && request.resource.data.keys().hasOnly(['uids', 'updatedAt'])
        && request.resource.data.uids is list
        && request.resource.data.uids.size() <= 100
        && !request.resource.data.uids.hasAny([ownerUid])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isActiveUser() && request.auth.uid == ownerUid;
    }

    // هل أستطيع رؤية قصة الأصدقاء المقربين؟ صاحبها، أو مدرَج في allowed.
    function closeStoryReadable(storyId) {
      let d = get(/databases/$(database)/documents/closeStories/$(storyId)).data;
      return d.uid == request.auth.uid || request.auth.uid in d.allowed;
    }

    // قصص الأصدقاء المقربين (24 ساعة): تُقرأ فقط لصاحبها ولمن في allowed.
    // الاستعلامات يجب أن تحمل where('allowed', arrayContains: uid) أو where('uid', ==, uid).
    match /closeStories/{storyId} {
      allow read: if isActiveUser()
        && (isAdmin()
            || resource.data.uid == request.auth.uid
            || request.auth.uid in resource.data.allowed);
      allow read, delete: if isAdmin();
      allow create: if isActiveUser()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.type == 'story'
        && request.resource.data.closeFriends == true
        && storyId.matches('^cf_[A-Za-z0-9]{10,40}$')
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 500
        && (request.resource.data.get('mediaUrl', null) == null
            || (request.resource.data.mediaUrl is string
                && request.resource.data.mediaUrl.size() <= 1000
                && request.resource.data.mediaUrl.matches('^https://[^ ]+$')))
        && request.resource.data.likes == 0
        && request.resource.data.get('comments', 0) == 0
        && request.resource.data.get('views', 0) == 0
        && request.resource.data.createdAt == request.time
        && authorMatchesProfile()
        // المستلمون: من قائمتي الحالية فقط (يمنع إرسال قصص لغير المقربين).
        && request.resource.data.allowed is list
        && request.resource.data.allowed.size() > 0
        && request.resource.data.allowed.size() <= 100
        && !request.resource.data.allowed.hasAny([request.auth.uid])
        && request.resource.data.allowed.toSet().difference(
            get(/databases/$(database)/documents/closeFriends/$(request.auth.uid)).data.uids.toSet()).size() == 0
        && (!('poll' in request.resource.data)
            || (request.resource.data.poll is map
                && request.resource.data.poll.keys().hasOnly(['q', 'a', 'b'])
                && request.resource.data.poll.q is string
                && request.resource.data.poll.q.size() > 0
                && request.resource.data.poll.q.size() <= 100
                && request.resource.data.poll.a is string
                && request.resource.data.poll.a.size() > 0
                && request.resource.data.poll.a.size() <= 40
                && request.resource.data.poll.b is string
                && request.resource.data.poll.b.size() > 0
                && request.resource.data.poll.b.size() <= 40))
        && (!('question' in request.resource.data)
            || (request.resource.data.question is map
                && request.resource.data.question.keys().hasOnly(['q'])
                && request.resource.data.question.q is string
                && request.resource.data.question.q.size() > 0
                && request.resource.data.question.q.size() <= 100))
        && (!('slider' in request.resource.data)
            || (request.resource.data.slider is map
                && request.resource.data.slider.keys().hasOnly(['q', 'e'])
                && request.resource.data.slider.q is string
                && request.resource.data.slider.q.size() <= 100
                && request.resource.data.slider.e is string
                && request.resource.data.slider.e.size() > 0
                && request.resource.data.slider.e.size() <= 16))
        && validStoryInfo(request.resource.data)
        && (!('mentions' in request.resource.data)
            || (request.resource.data.mentions is list
                && request.resource.data.mentions.size() <= 3));
      allow update: if false;
      allow delete: if isActiveUser() && resource.data.uid == request.auth.uid;

      match /views/{viewerUid} {
        allow read: if isActiveUser()
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid == request.auth.uid;
        allow create, update: if isActiveUser()
          && request.auth.uid == viewerUid
          && closeStoryReadable(storyId)
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid != viewerUid
          && request.resource.data.keys().hasOnly(['at', 'e'])
          && request.resource.data.at == request.time
          && validViewReaction(request.resource.data);
        allow read, delete: if isAdmin();
        allow delete: if isActiveUser()
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid == request.auth.uid;
      }

      match /votes/{voterUid} {
        allow read: if isActiveUser() && (isAdmin() || closeStoryReadable(storyId));
        allow create: if isActiveUser()
          && request.auth.uid == voterUid
          && closeStoryReadable(storyId)
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid != voterUid
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.get('poll', null) != null
          && request.resource.data.keys().hasOnly(['choice', 'at'])
          && request.resource.data.choice in [0, 1]
          && request.resource.data.at == request.time;
        allow delete: if isAdmin();
        allow delete: if isActiveUser()
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid == request.auth.uid;
      }

      match /sliderVotes/{voterUid} {
        allow read: if isActiveUser() && (isAdmin() || closeStoryReadable(storyId));
        allow create: if isActiveUser()
          && request.auth.uid == voterUid
          && closeStoryReadable(storyId)
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid != voterUid
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.get('slider', null) != null
          && request.resource.data.keys().hasOnly(['v', 'at'])
          && request.resource.data.v is int
          && request.resource.data.v >= 0
          && request.resource.data.v <= 100
          && request.resource.data.at == request.time;
        allow delete: if isAdmin();
        allow delete: if isActiveUser()
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid == request.auth.uid;
      }

      match /answers/{responderUid} {
        allow read: if isActiveUser()
          && (isAdmin()
              || request.auth.uid == responderUid
              || get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid == request.auth.uid);
        allow create: if isActiveUser()
          && request.auth.uid == responderUid
          && closeStoryReadable(storyId)
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid != responderUid
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.get('question', null) != null
          && request.resource.data.keys().hasOnly(['username', 'name', 'text', 'at'])
          && request.resource.data.username is string
          && request.resource.data.username == myProfile().username
          && request.resource.data.name is string
          && (request.resource.data.name == myProfile().name
              || request.resource.data.name == myProfile().username)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 200
          && request.resource.data.at == request.time;
        allow delete: if isAdmin();
        allow delete: if isActiveUser()
          && get(/databases/$(database)/documents/closeStories/$(storyId)).data.uid == request.auth.uid;
      }
    }

    // أرشيف قصصي: نسخة من كل قصة أنشرها تبقى بعد انتهاء الـ24 ساعة.
    // خاص بصاحبه وحده (القراءة والإنشاء والحذف)، ولا تعديل على النسخ.
    match /storyArchive/{ownerUid}/stories/{storyId} {
      allow read: if isActiveUser() && (request.auth.uid == ownerUid || isAdmin());
      allow create: if isActiveUser()
        && request.auth.uid == ownerUid
        && request.resource.data.uid == ownerUid
        && request.resource.data.type == 'story'
        && request.resource.data.keys().size() <= 40
        && request.resource.data.caption is string
        && request.resource.data.caption.size() <= 500
        && (request.resource.data.get('mediaUrl', null) == null
            || (request.resource.data.mediaUrl is string
                && request.resource.data.mediaUrl.size() <= 1000
                && request.resource.data.mediaUrl.matches('^https://[^ ]+$')))
        && request.resource.data.archivedAt == request.time;
      allow update: if false;
      allow delete: if isActiveUser() && (request.auth.uid == ownerUid || isAdmin());
    }

    // القصص المميزة: نسخ مستقلة من القصص (حتى 30 في المميزة) تظهر في الملف الشخصي.
    // يقرؤها صاحبها، وأي مستخدم يحق له رؤية ملفه (عام، أو خاص وأتابعه).
    match /storyHighlights/{ownerUid}/highlights/{hid} {
      allow read: if isActiveUser()
        && (isAdmin()
            || request.auth.uid == ownerUid
            || !isPrivateUser(ownerUid)
            || followsUser(ownerUid));
      allow create: if isActiveUser()
        && request.auth.uid == ownerUid
        && request.resource.data.keys().hasOnly(['title', 'items', 'cover', 'createdAt', 'updatedAt'])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 24
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 30
        && request.resource.data.cover is int
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isActiveUser()
        && request.auth.uid == ownerUid
        && request.resource.data.keys().hasOnly(['title', 'items', 'cover', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 24
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 30
        && request.resource.data.cover is int
        && request.resource.data.updatedAt == request.time;
      allow delete: if isActiveUser() && (request.auth.uid == ownerUid || isAdmin());
    }

    // مشاهداتي للقصص (تُزامَن بين أجهزتي): خريطة m من معرّف القصة إلى وقت المشاهدة.
    match /storySeen/{ownerUid} {
      allow read: if isActiveUser() && request.auth.uid == ownerUid;
      allow create, update: if isActiveUser()
        && request.auth.uid == ownerUid
        && request.resource.data.keys().hasOnly(['m', 'updatedAt'])
        && request.resource.data.m is map
        && request.resource.data.m.size() <= 1000
        && request.resource.data.updatedAt == request.time;
      allow delete: if isActiveUser() && (request.auth.uid == ownerUid || isAdmin());
    }

    match /media/{chunkId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(['uid', 'i', 'data'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data is bytes
        && request.resource.data.data.size() < 950000;
      allow update: if false;
      allow delete: if isAdmin()
        || (isActiveUser() && resource.data.uid == request.auth.uid);
    }

    // حجز أسماء المستخدمين (فريدة). القراءة المفردة مفتوحة للتحقق من التوفر قبل التسجيل.
    match /usernames/{name} {
      allow get: if true;
      allow create: if isActiveUser()
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9._]{3,24}$');
      allow update: if false;
      allow delete: if isAdmin()
        || (isActiveUser() && resource.data.uid == request.auth.uid);
    }

    // الملف الشخصي: الاسم + اسم المستخدم + النبذة
    match /users/{uid} {
      allow read: if isActiveUser();
      // الزائر: الملف العام (الاسم، الصورة، النبذة) والبحث. لا يحتوي بريداً ولا بيانات خاصة.
      allow read: if isGuest();
      // لوحة التحكم: حذف ملف الحساب ضمن حذف المستخدم.
      allow delete: if isAdmin();
      allow create, update: if isActiveUser()
        && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9._]{3,24}$')
        // اسم المستخدم: إما لم يتغيّر، أو محجوز باسمي في usernames (يمنع أخذ اسم غيري).
        && (
          (resource != null
            && resource.data.get('username', '') == request.resource.data.username)
          || (existsAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username))
            && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid
              == request.auth.uid)
        )
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 150
        && request.resource.data.get('isPrivate', false) is bool
        && request.resource.data.get('hideLikes', false) is bool
        && request.resource.data.get('pinnedPostIds', []) is list
        && request.resource.data.get('website', '') is string
        && request.resource.data.get('website', '').size() <= 100
        && (request.resource.data.get('website', '') == ''
            || request.resource.data.get('website', '').matches('^https?://[^ ]+$'))
        && request.resource.data.get('pinnedPostIds', []).size() <= 3
        && (request.resource.data.get('photoB64', null) == null
            || request.resource.data.photoB64.size() < 200000);
    }

    match /users/{uid}/{sub}/{doc} {
      // لوحة التحكم عند حذف حساب: قراءة وحذف كل المجموعات الفرعية للمستخدم.
      allow read: if isAdmin();
      allow delete: if isAdmin();
      // الزائر: يحتاج المتابعين/المتابَعين لعرض الأعداد فقط (count). القوائم نفسها
      // تُقفل في الواجهة وتطلب تسجيل دخول؛ Firestore لا يفصل بين العدّ والقراءة.
      allow read: if isGuest() && (sub == 'followers' || sub == 'following');

      // طلبات المتابعة: يقرؤها صاحب الحساب أو مرسل الطلب فقط. المحفوظات لصاحبها، والإعجابات حسب إعدادات صاحبها،
      // وباقي المجموعات (المتابَعون/المتابِعون) مفتوحة للقراءة لأن العدّادات تعتمد عليها.
      allow read: if isActiveUser()
        && (sub != 'notifications' || request.auth.uid == uid)
        && (sub != 'followRequests' || request.auth.uid == uid || request.auth.uid == doc)
        && (sub != 'profileVisits' || request.auth.uid == uid)
        && (sub != 'hiddenPosts' || request.auth.uid == uid)
        && (sub != 'pushTokens' || request.auth.uid == uid)
        // المحفوظات (رسائل محفوظة) خاصة بصاحبها وحده.
        && (sub != 'savedMessages' || request.auth.uid == uid)
        // المحفوظات خاصة بصاحبها وحده.
        && (sub != 'saved' || request.auth.uid == uid)
        // قائمة الإعجابات: تحترم «إخفاء الإعجابات» وخصوصية الحساب.
        && (sub != 'liked' || request.auth.uid == uid || canViewLikes(uid));

      allow create: if isActiveUser() && (
        (request.auth.uid == uid && sub == 'pushTokens'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 30
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['web', 'android', 'ios']
          && request.resource.data.updatedAt == request.time) ||
        // رسالة محفوظة: نسخة من رسالة داخل محادثة، لصاحب الحساب وحده.
        (request.auth.uid == uid && sub == 'savedMessages'
          && validSavedMessageCreate()) ||
        // المالك: saved / liked ... لكن ليس followers ولا followRequests ولا الإشعارات.
        // المالك يكتب فقط المجموعات المعروفة (محفوظات/إعجابات/مخفيّات)، كل مستند حقل at فقط:
        // يمنع إنشاء مجموعات عشوائية أو تخزين بيانات كبيرة مجاناً في حسابه.
        (request.auth.uid == uid
          && sub in ['saved', 'liked', 'hiddenPosts']
          && request.resource.data.keys().hasOnly(['at'])) ||
        // متابعة مباشرة: فقط إذا كان الحساب الهدف عاماً.
        (sub == 'following' && request.auth.uid == uid
          && doc != uid && !isPrivateUser(doc)
          && !isBlocked(uid, doc)) ||
        (sub == 'followers' && doc == request.auth.uid
          && doc != uid && !isPrivateUser(uid)
          && !isBlocked(uid, doc)) ||
        // طلب متابعة: يرسله المتابِع إلى حساب خاص فقط.
        (sub == 'followRequests' && doc == request.auth.uid
          && doc != uid && isPrivateUser(uid)
          && !isBlocked(uid, doc)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time
          && !exists(/databases/$(database)/documents/users/$(uid)/followers/$(doc))) ||
        // الموافقة: صاحب الحساب الخاص يضيف المتابِع بعد وجود طلبه فقط.
        (sub == 'followers' && request.auth.uid == uid
          && exists(/databases/$(database)/documents/users/$(uid)/followRequests/$(doc))) ||
        (sub == 'following' && doc == request.auth.uid
          && exists(/databases/$(database)/documents/users/$(doc)/followRequests/$(uid))) ||
        // زيارة الملف الشخصي: الزائر يسجّل زيارته بنفسه فقط (وقت الخادم).
        (sub == 'profileVisits' && doc == request.auth.uid
          && doc != uid && !isBlocked(uid, doc)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time) ||
        (sub == 'notifications' && validNotificationCreate(uid, doc))
      );
      allow update: if isActiveUser() && (
        (request.auth.uid == uid && sub == 'pushTokens'
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() >= 30
          && request.resource.data.token.size() <= 4096
          && request.resource.data.platform in ['web', 'android', 'ios']
          && request.resource.data.updatedAt == request.time) ||
        (request.auth.uid == uid && sub == 'savedMessages'
          && validSavedMessageCreate()) ||
        (request.auth.uid == uid
          && sub in ['saved', 'liked', 'hiddenPosts']
          && request.resource.data.keys().hasOnly(['at'])) ||
        (sub == 'following' && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['at'])) ||
        (sub == 'followers' && doc == request.auth.uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time) ||
        // زيارة الملف الشخصي: الزائر يسجّل زيارته بنفسه فقط (وقت الخادم).
        (sub == 'profileVisits' && doc == request.auth.uid
          && doc != uid && !isBlocked(uid, doc)
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time) ||
        (sub == 'notifications' && validNotificationCreate(uid, doc)) ||
        (sub == 'notifications' && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool)
      );
      allow delete: if isActiveUser()
        && ((request.auth.uid == uid && sub != 'notifications' && sub != 'followers')
          || (sub == 'followers' && doc == request.auth.uid)
          || (sub == 'followRequests' && doc == request.auth.uid)
          || (sub == 'notifications' && request.auth.uid == uid));
    }

    // لوحة التحكم (بدون Cloud Functions): استعلامات المجموعات (collection group) للأدمن فقط.
    match /{path=**}/comments/{commentId} {
      allow read: if isAdmin();
    }
    match /{path=**}/notifications/{notificationId} {
      allow read: if isAdmin();
    }
  }
}
