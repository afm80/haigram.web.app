rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.caption.size() <= 500
        && request.resource.data.likes == 0;
      // المالك يعدّل/يحذف، وأي مستخدم مسجّل يستطيع فقط زيادة/إنقاص عداد الإعجاب بمقدار 1
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && math.abs(request.resource.data.likes - resource.data.likes) == 1)
      );
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // قطع الملفات (وضع التجربة): كل قطعة تحمل uid صاحبها ولا تُعدَّل بعد إنشائها
    match /media/{chunkId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data.size() < 950000;
      allow update, delete: if false;
    }

    match /users/{uid}/{sub}/{doc} {
      allow read: if request.auth != null;
      // saved / following: للمالك فقط. followers: يكتب فيها المتابِع نفسه.
      allow write: if request.auth != null && (
        request.auth.uid == uid ||
        (sub == 'followers' && doc == request.auth.uid)
      );
    }
  }
}
