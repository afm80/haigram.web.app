rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function followsAfter(followerUid, followedUid) {
      return existsAfter(/databases/$(database)/documents/users/$(followerUid)/following/$(followedUid));
    }

    function isMutualFriendAfter(firstUid, secondUid) {
      return followsAfter(firstUid, secondUid)
        && followsAfter(secondUid, firstUid);
    }

    function isBlocked(firstUid, secondUid) {
      return exists(/databases/$(database)/documents/userBlocks/$(firstUid)/blocked/$(secondUid))
        || exists(/databases/$(database)/documents/userBlocks/$(secondUid)/blocked/$(firstUid));
    }

    function validNotificationCreate(ownerUid, notificationId) {
      let data = request.resource.data;
      let actorUid = request.auth.uid;
      return data.actorUid == actorUid
        && actorUid != ownerUid
        && data.actorUsername is string
        && data.actorUsername.size() <= 24
        && get(/databases/$(database)/documents/users/$(actorUid)).data.username
          == data.actorUsername
        && data.read == false
        && data.createdAt == request.time
        && (
          (data.type == 'follow'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'read', 'createdAt'])
            && notificationId == 'follow_' + actorUid
            && existsAfter(/databases/$(database)/documents/users/$(ownerUid)/followers/$(actorUid))
            && followsAfter(actorUid, ownerUid))
          ||
          (data.type == 'like'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'postId', 'read', 'createdAt'])
            && data.postId is string
            && notificationId == 'like_' + data.postId + '_' + actorUid
            && get(/databases/$(database)/documents/posts/$(data.postId)).data.uid == ownerUid
            && existsAfter(/databases/$(database)/documents/posts/$(data.postId)/likes/$(actorUid)))
          ||
          (data.type == 'comment'
            && data.keys().hasOnly(['type', 'actorUid', 'actorUsername', 'postId', 'commentId', 'commentText', 'read', 'createdAt'])
            && data.postId is string
            && data.commentId is string
            && data.commentText is string
            && data.commentText.size() > 0
            && data.commentText.size() <= 500
            && notificationId == 'comment_' + data.commentId
            && get(/databases/$(database)/documents/posts/$(data.postId)).data.uid == ownerUid
            && getAfter(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId)).data.uid == actorUid
            && getAfter(/databases/$(database)/documents/posts/$(data.postId)/comments/$(data.commentId)).data.text == data.commentText)
        );
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.caption.size() <= 500
        && request.resource.data.likes == 0;
      // المالك يعدّل/يحذف، وأي مستخدم مسجّل يستطيع فقط زيادة/إنقاص عدّاد الإعجاب أو التعليقات بمقدار 1
      allow update: if request.auth != null && (
        resource.data.uid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
          && math.abs(request.resource.data.likes - resource.data.likes) == 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
          && math.abs(request.resource.data.comments - resource.data.get('comments', 0)) == 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shares'])
          && request.resource.data.shares == resource.data.get('shares', 0) + 1) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views == resource.data.get('views', 0) + 1
          && existsAfter(/databases/$(database)/documents/posts/$(postId)/viewers/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/posts/$(postId)/viewers/$(request.auth.uid)))
      );
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      match /likes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // المشاهدات: مستند لكل مشاهد يُنشأ مرة واحدة فقط (يمنع تكرار العدّ)
      match /viewers/{uid} {
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow read, update, delete: if false;
      }

      // التعليقات: يكتبها أي مستخدم مسجّل، ويحذفها صاحبها أو صاحب المنشور
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && request.resource.data.get('kind', 'text') in ['text', 'sticker', 'image']
          && (!('image' in request.resource.data)
            || (request.resource.data.kind == 'image'
              && request.resource.data.image is bytes
              && request.resource.data.image.size() <= 716800));
        allow update: if request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['likedBy'])
          && request.resource.data.likedBy is list
          && request.resource.data.likedBy.size()
            <= resource.data.get('likedBy', []).size() + 1
          && request.resource.data.likedBy.size()
            >= resource.data.get('likedBy', []).size() - 1
          && (
            (request.resource.data.likedBy.hasAll(
                resource.data.get('likedBy', [])
              )
              && request.resource.data.likedBy.size()
                == resource.data.get('likedBy', []).size() + 1
              && !resource.data.get('likedBy', []).hasAny([request.auth.uid])
              && request.resource.data.likedBy.hasAny([request.auth.uid]))
            ||
            (resource.data.get('likedBy', []).hasAll(
                request.resource.data.likedBy
              )
              && request.resource.data.likedBy.size()
                == resource.data.get('likedBy', []).size() - 1
              && resource.data.get('likedBy', []).hasAny([request.auth.uid])
              && !request.resource.data.likedBy.hasAny([request.auth.uid]))
          );
        allow delete: if request.auth != null && (
          resource.data.uid == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.uid == request.auth.uid
        );
      }
    }

    match /chats/{chatId} {
      function isParticipant() {
        return request.auth != null
          && request.auth.uid in resource.data.participants;
      }

      allow get: if request.auth != null
        && (!exists(/databases/$(database)/documents/chats/$(chatId))
          || isParticipant());
      allow list: if isParticipant();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'participants', 'lastMessage', 'lastSenderUid', 'lastMessageId',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.hasAny([request.auth.uid])
        && request.resource.data.participants[0] is string
        && request.resource.data.participants[1] is string
        && request.resource.data.participants[0] != request.resource.data.participants[1]
        && isMutualFriendAfter(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        )
        && !isBlocked(
          request.resource.data.participants[0],
          request.resource.data.participants[1]
        )
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastSenderUid == ''
        && request.resource.data.lastMessageId == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if request.auth != null
        && resource.data.participants is list
        && resource.data.participants.hasAny([request.auth.uid])
        && (
          (!isBlocked(
              resource.data.participants[0],
              resource.data.participants[1]
            )
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'lastMessage', 'lastSenderUid', 'lastMessageId', 'updatedAt'
              ])
            && request.resource.data.lastMessage is string
            && request.resource.data.lastMessage.size() > 0
            && request.resource.data.lastMessage.size() <= 2000
            && request.resource.data.lastSenderUid == request.auth.uid
            && request.resource.data.lastMessageId is string
            && request.resource.data.lastMessageId.size() > 0
            && request.resource.data.updatedAt == request.time
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderUid
              == request.auth.uid
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text
              == request.resource.data.lastMessage
            && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.createdAt
              == request.time)
          ||
          (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly([
                'lastMessage', 'lastSenderUid', 'lastMessageId', 'updatedAt'
              ])
            && request.resource.data.updatedAt == request.time
            && resource.data.lastMessageId is string
            && resource.data.lastMessageId.size() > 0
            && exists(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId))
            && get(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId)).data.senderUid
              == request.auth.uid
            && !existsAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(resource.data.lastMessageId))
            && (
              (request.resource.data.lastMessage == ''
                && request.resource.data.lastSenderUid == ''
                && request.resource.data.lastMessageId == '')
              ||
              (request.resource.data.lastMessage is string
                && request.resource.data.lastMessage.size() > 0
                && request.resource.data.lastMessage.size() <= 2000
                && request.resource.data.lastSenderUid is string
                && request.resource.data.lastMessageId is string
                && request.resource.data.lastMessageId.size() > 0
                && request.resource.data.lastMessageId
                  != resource.data.lastMessageId
                && existsAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId))
                && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.text
                  == request.resource.data.lastMessage
                && getAfter(/databases/$(database)/documents/chats/$(chatId)/messages/$(request.resource.data.lastMessageId)).data.senderUid
                  == request.resource.data.lastSenderUid))
          )
        );
      allow delete: if false;

      match /messages/{messageId} {
        function isChatParticipant() {
          return request.auth != null
            && request.auth.uid in
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }

        allow read: if isChatParticipant();
        allow create: if isChatParticipant()
          && request.resource.data.keys().hasOnly([
            'senderUid', 'text', 'kind', 'image', 'deliveredTo', 'readBy',
            'createdAt'
          ])
          && request.resource.data.keys().hasAll([
            'senderUid', 'text', 'kind', 'deliveredTo', 'readBy', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && (
            (request.resource.data.kind == 'image'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'image', 'deliveredTo',
                'readBy', 'createdAt'
              ])
              && request.resource.data.image is bytes
              && request.resource.data.image.size() <= 716800)
            ||
            (request.resource.data.kind == 'text'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'deliveredTo', 'readBy',
                'createdAt'
              ])
              && request.resource.data.text.size() <= 2000)
            ||
            (request.resource.data.kind == 'sticker'
              && request.resource.data.keys().hasOnly([
                'senderUid', 'text', 'kind', 'deliveredTo', 'readBy',
                'createdAt'
              ])
              && request.resource.data.text.size() <= 24)
          )
          && !isBlocked(
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants[0],
            get(/databases/$(database)/documents/chats/$(chatId)).data.participants[1]
          )
          && request.resource.data.deliveredTo == [request.auth.uid]
          && request.resource.data.readBy == [request.auth.uid]
          && request.resource.data.createdAt == request.time
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastSenderUid
            == request.auth.uid
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessageId
            == messageId
          && getAfter(/databases/$(database)/documents/chats/$(chatId)).data.lastMessage
            == request.resource.data.text;
        allow update: if isChatParticipant()
          && resource.data.senderUid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deliveredTo', 'readBy'])
          && request.resource.data.deliveredTo is list
          && request.resource.data.deliveredTo
            .hasAll(resource.data.get('deliveredTo', []))
          && request.resource.data.deliveredTo.hasAny([request.auth.uid])
          && request.resource.data.deliveredTo.size()
            <= resource.data.get('deliveredTo', []).size() + 1
          && request.resource.data.readBy is list
          && request.resource.data.readBy.hasAll(resource.data.get('readBy', []))
          && request.resource.data.readBy.hasAny([request.auth.uid])
          && request.resource.data.readBy.size()
            <= resource.data.get('readBy', []).size() + 1;
        allow delete: if isChatParticipant()
          && resource.data.senderUid == request.auth.uid;
      }

      // رسائل «حذف لديّ فقط»: مستند لكل مستخدم يخص نفسه فقط.
      match /hiddenMessages/{uid} {
        function isParticipantHere() {
          return request.auth != null
            && request.auth.uid in
              get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        }
        allow read: if isParticipantHere() && request.auth.uid == uid;
        allow create, update: if isParticipantHere()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['ids', 'updatedAt'])
          && request.resource.data.ids is list
          && request.resource.data.ids.size() <= 500
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }

    match /userBlocks/{uid}/blocked/{otherUid} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || request.auth.uid == otherUid);
      allow create: if request.auth != null
        && request.auth.uid == uid
        && uid != otherUid
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // البلاغات: الإنشاء فقط من المستخدم المسجّل، والقراءة من لوحة Firebase (المشرف).
    match /reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly([
          'type', 'targetUid', 'reporterUid', 'reason', 'details', 'createdAt'
        ])
        && request.resource.data.type == 'user'
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid
        && request.resource.data.reason in [
          'spam', 'abuse', 'inappropriate', 'impersonation', 'other'
        ]
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 300
        && request.resource.data.createdAt == request.time;
      allow read, update, delete: if false;
    }

    match /presence/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['online', 'updatedAt'])
        && request.resource.data.online is bool
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // قطع الملفات (وضع التجربة): كل قطعة تحمل uid صاحبها، لا تُعدَّل، ويحذفها صاحبها فقط
    match /media/{chunkId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.data.size() < 950000;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // حجز أسماء المستخدمين (فريدة). القراءة المفردة مفتوحة للتحقق من التوفر قبل التسجيل.
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9._]{3,24}$');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // الملف الشخصي: الاسم + اسم المستخدم + النبذة
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.username is string
        && request.resource.data.username.matches('^[a-z0-9._]{3,24}$')
        && request.resource.data.name.size() <= 50
        && request.resource.data.bio.size() <= 150
        && request.resource.data.get('pinnedPostIds', []).size() <= 3
        && (request.resource.data.get('photoB64', null) == null
            || request.resource.data.photoB64.size() < 200000);
    }

    match /users/{uid}/{sub}/{doc} {
      allow read: if request.auth != null
        && (sub != 'notifications' || request.auth.uid == uid);
      // saved / following: للمالك فقط. followers: يكتب فيها المتابِع نفسه.
      allow create: if request.auth != null && (
        (request.auth.uid == uid && sub != 'notifications') ||
        (sub == 'followers' && doc == request.auth.uid) ||
        (sub == 'notifications' && validNotificationCreate(uid, doc))
      );
      allow update: if request.auth != null && (
        (request.auth.uid == uid && sub != 'notifications') ||
        (sub == 'followers' && doc == request.auth.uid
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time) ||
        (sub == 'notifications' && validNotificationCreate(uid, doc)) ||
        (sub == 'notifications' && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool)
      );
      allow delete: if request.auth != null
        && ((request.auth.uid == uid && sub != 'notifications')
          || (sub == 'followers' && doc == request.auth.uid)
          || (sub == 'notifications' && request.auth.uid == uid));
    }
  }
}
